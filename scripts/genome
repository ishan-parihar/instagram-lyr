    'literature-research': '# literature-research: papers in, verbatim claims out, synthesis and literature-based discovery on top.\n# Built for medical science; works for any field with citable sources.\n[blueprint]\nname = "literature-research"\nversion = "1"\nsummary = "papers → verbatim claims → normalised concepts → graded findings → novel, testable hypotheses (Swanson ABC gaps, contradictions); retractions cascade"\nmodules = ["core", "records"]\nroutes = [\n  ["which questions are open, and what answers them", "`genome find question` / `docs/EVIDENCE.md`"],\n  ["what the evidence says, and how certain it is (GRADE)", "`docs/EVIDENCE.md#findings` (generated)"],\n  ["where a claim comes from (verbatim quote, locator, source)", "`genome show CL-n`"],\n  ["what was searched, where, with which query and yield (PRISMA)", "`research/searches.jsonl` (`genome find search`)"],\n  ["candidate discoveries: concepts never linked that share mechanisms", "`genome graph gaps --kind concept`"],\n]\nplaybook = \'\'\'\n**What this is.** A research pipeline that agents can run on their own. Every number and every assertion\ntraces back to a verbatim span of a source. Synthesis is graded, and discovery is a testable hypothesis, never\na conclusion. **Not medical advice.** Findings carry their GRADE certainty, and hypotheses stay hypotheses\nuntil a recorded test says otherwise. `supported` is human-only.\n\n**Pipeline and kinds.**\n- `question` (PICO: population, intervention, comparator, outcome): open → answered | dropped.\n- `search` (append-only log: database, query, `executed` yes|no, hits, screened, included). Log every search,\n  including the novelty searches done for hypotheses. If you could not run it (no access), log it with\n  `executed=no` and say so in the report; a hypothesis is `screened` only on the evidence of an executed search.\n- `source`: citation, doi, pmid, year, `design`, n, population, funding.\n  - States: queued → screened → included | excluded (excluded → screened to reconsider; no jumping ahead).\n  - `retracted` can be reached from any state, with the retraction notice as evidence.\n- `claim` (append-only):\n  - `quote` is the exact words, and `locator` names where they are (page, table, figure);\n  - `effect` holds the reported number with its interval, and `direction` says which way it points;\n  - it cites exactly one source, and has a `subject` and an `object` concept;\n  - extracted → verified needs evidence: a second pass that checked the quote against the source.\n- `concept`: a drug, gene, disease, pathway, mechanism, outcome and so on, with an `ontology_id` (MeSH, HGNC,\n  ChEBI, UMLS).\n  - Normalise before linking: one concept per thing. "fish oil" and "omega-3 fatty acids" are one concept\n    (`same_as`, then re-link).\n  - Discovery is only as good as this step.\n- `finding`: a statement about a body of evidence, with required `certainty` (high, moderate, low, very-low,\n  as in GRADE). It is supported by at least one claim and may be contradicted by others; reviewed needs\n  evidence.\n- `hypothesis`: a novel, falsifiable proposal grounded in claims or findings.\n  - States: proposed → screened (a logged novelty search shows it is not already published) → testing →\n    supported | refuted | inconclusive.\n\n**Retractions cascade.** Move the source to `retracted`. `genome lint` then flags each claim citing it (E510);\nquarantine those claims (`genome move CL-1,CL-7 quarantined --evidence SRC-n`). Lint then flags the findings and\nhypotheses built on them, and the same step repeats one hop at a time, each hop a reviewed step.\n\n**The loop.**\n1. `genome wake`. The QUEUE shows sources to screen, claims to verify, open questions and hypotheses waiting.\n2. Search: `genome new search --set database=PubMed --set query="…" --set hits=212 --link for_question=RQ-1`.\n3. Ingest one paper in **one call**. Write JSON lines and run `genome new --batch claims.jsonl`:\n   - line 1 is the source: `{"kind":"source","title":"Smith 2021","set":{"citation":"…","design":"rct","n":412,"doi":"…"}}`;\n   - each later line is a claim:\n     `{"kind":"claim","title":"EPA lowers viscosity","set":{"quote":"…","locator":"p.4 Table 2","direction":"decreases"},"link":{"cites":"@1","subject":"CO-3","object":"CO-9"}}`;\n   - `@1` is the source made by line 1. A bad line writes nothing.\n4. Verify claims in a separate pass, ideally by another agent, and only against the paper\'s text. With no text to\n   check against, leave them `extracted` and say so in the report: `verified` is a claim about having checked. Check the quote against the source **and** the\n   numbers and signs in `effect` (a confidence interval\'s sign and bounds are the commonest slip):\n   `genome move CL-12,CL-13 verified --evidence research/sources/SRC-0004-….md`. The evidence is the source: its file under\n   `research/sources/` if you stored one, otherwise its id (`--evidence SRC-0004`). Verify one source\'s claims per call. A verified move cannot be corrected afterwards: `disputed` and\n   back to `extracted` is the way.\n5. Synthesise: `genome new finding --title "…" --set statement="…" --set certainty=moderate --link supported_by=CL-12,CL-13`.\n6. Discover:\n   - `genome graph gaps --kind concept`: Swanson ABC. A and C share intermediate concepts B but no claim links\n     A to C. Gaps are computed from claims only: a hypothesis\'s `bridges`, `via` and `grounded_in` are proposals and\n     provenance, so they do not close a gap (otherwise a hypothesis would confirm itself).\n   - `genome graph gaps --kind concept --across type`: the same, kept to pairs of different types (drug ↔ disease).\n   - `genome graph hubs --kind concept` shows the central mechanisms; `genome graph bridges --kind concept`\n     shows single-mechanism links.\n   - `genome find finding --where consistency=inconsistent` lists contradictions, which also seed hypotheses.\n7. Propose: `genome new hypothesis --title "…" --set statement="…" --set origin=abc-gap --set prediction="…" --set\n   test="…" --link grounded_in=CL-12,FI-3 --link bridges=CO-3,CO-21 --link via=CO-9`.\n   - Before `screened`, run and log a novelty search: `genome move HY-2 screened --evidence SR-0031`. The evidence must\n     be a `search` with `executed=yes`; a search you could not run is logged with `executed=no` and the hypothesis\n     stays `proposed`. (A mistaken `screened` goes back with `genome move HY-2 proposed`.)\n8. `genome close`: lint covers the schema, taint, citations and evidence.\n\n**Retracted or unusable evidence.** A finding or hypothesis cannot rest on a quarantined claim; that is the point.\nRecord why a paper was set aside in the source\'s `--body`, and the consequence in `genome log`. Before moving a\nretracted source, `genome impact SRC-0001 --to retracted` lists every claim, finding and hypothesis that would be\nflagged, hop by hop, with the move commands. If nothing is left standing, there is no finding: the question stays open\nand the log says why. Enum values for every\nfield are in `genome blueprint show literature-research`.\n\n**Token rules.** Never paste a paper into the genome: extract claims with their locators. Read claims with\n`genome show CL-n,CL-m`, and query with `find` and `graph`. For bulk work, write one batch file per paper (`@N` is the\n1-based line number, and a link value is an id, `"A,B"` or a list).\n\'\'\'\n\n[kinds.question]\npath = "research/questions"\nid = "RQ-{n:03}"\nfields = { type = "enum:therapy|etiology|diagnosis|prognosis|mechanism|discovery!", population = "text", intervention = "text", comparator = "text", outcome = "text" }\nstates = ["open", "answered", "dropped"]\ntransitions = { open = ["answered", "dropped"], answered = ["open"], dropped = ["open"] }\nevidence_on = ["answered"]\n[kinds.question.relations]\nanswered_by = { to = "finding", required_in = ["answered"], graph = false, inverse = "answers" }\n\n[kinds.search]\npath = "research/searches.jsonl"\nstore = "jsonl"\nid = "SR-{n:04}"\nfields = { database = "text!", query = "text!", executed = "enum:yes|no!", hits = "int", screened = "int", included = "int", date = "date" }\n[kinds.search.relations]\nfor_question = { to = "question|hypothesis", graph = false, inverse = "searched-by" }\n\n[kinds.source]\npath = "research/sources"\nid = "SRC-{n:04}"\nfields = { citation = "text!", design = "enum:meta-analysis|systematic-review|rct|cohort|case-control|cross-sectional|case-series|case-report|animal|in-vitro|in-silico|mechanistic|narrative-review|guideline|preprint|other!", doi = "text", pmid = "text", year = "int:1800..2100", n = "int", population = "text", funding = "text", file = "text" }\nstates = ["queued", "screened", "included", "excluded", "retracted"]\ntransitions = { queued = ["screened", "excluded"], screened = ["included", "excluded"], excluded = ["screened"] }\nquarantine = "retracted"\n[kinds.source.relations]\nfound_by = { to = "search", graph = false, inverse = "found" }\n\n[kinds.claim]\npath = "research/claims.jsonl"\nstore = "jsonl"\nid = "CL-{n:05}"\nfields = { quote = "text!", locator = "text!", effect = "text", direction = "enum:increases|decreases|no-effect|associated|inverse|mixed|unclear", population = "text" }\nstates = ["extracted", "verified", "disputed", "quarantined"]\ntransitions = { extracted = ["verified", "disputed"], disputed = ["verified", "extracted"], verified = ["disputed"] }\nevidence_on = ["verified"]\nquarantine = "quarantined"\n[kinds.claim.relations]\ncites = { to = "source", min = 1, max = 1, taint = ["retracted"], inverse = "claim" }\nsubject = { to = "concept", min = 1, inverse = "subject-of" }\nobject = { to = "concept", inverse = "object-of" }\n\n[kinds.concept]\npath = "research/concepts"\nid = "CO-{n:04}"\nfields = { type = "enum:drug|gene|protein|pathway|disease|symptom|mechanism|outcome|biomarker|exposure|intervention|population|organism|tissue|other!", ontology_id = "text", synonyms = "text" }\nstates = ["candidate", "normalised", "merged"]\ntransitions = { candidate = ["normalised", "merged"], normalised = ["merged"] }\n[kinds.concept.relations]\nis_a = { to = "concept", inverse = "kind" }\npart_of = { to = "concept", inverse = "has-part" }\nsame_as = { to = "concept", max = 1, required_in = ["merged"], graph = false, inverse = "alias" }\n\n[kinds.finding]\npath = "research/findings"\nid = "FI-{n:04}"\nfields = { statement = "text!", certainty = "enum:high|moderate|low|very-low!", consistency = "enum:consistent|inconsistent|unclear", applies_to = "text" }\nstates = ["draft", "reviewed", "superseded", "quarantined"]\ntransitions = { draft = ["reviewed", "superseded"], reviewed = ["superseded", "draft"] }\nevidence_on = ["reviewed"]\nquarantine = "quarantined"\n[kinds.finding.relations]\nsupported_by = { to = "claim", min = 1, taint = ["quarantined"], inverse = "supports" }\ncontradicted_by = { to = "claim", inverse = "contradicts" }\nabout = { to = "concept", inverse = "finding" }\nsupersedes = { to = "finding", graph = false, inverse = "superseded-by" }\n\n[kinds.hypothesis]\npath = "research/hypotheses"\nid = "HY-{n:04}"\nfields = { statement = "text!", origin = "enum:abc-gap|contradiction|mechanism|analogy|operator!", prediction = "text", test = "text", novelty = "text" }\nstates = ["proposed", "screened", "testing", "supported", "refuted", "inconclusive", "parked", "quarantined"]\ntransitions = { proposed = ["screened", "parked"], screened = ["testing", "parked", "proposed"], testing = ["supported", "refuted", "inconclusive"], parked = ["proposed"], inconclusive = ["testing"] }\nevidence_on = ["screened", "supported", "refuted", "inconclusive"]\nevidence_ref = { screened = "search?executed=yes" }\nhuman_only = ["supported"]\nquarantine = "quarantined"\n[kinds.hypothesis.relations]\ngrounded_in = { to = "claim|finding", min = 1, taint = ["quarantined"], graph = false, inverse = "grounds" }\nbridges = { to = "concept", graph = false, inverse = "bridged-by" }\nvia = { to = "concept", graph = false, inverse = "mediates" }\n\n[views.to-screen]\nkind = "source"\nstate = "queued"\nwake = true\n\n[views.to-verify]\nkind = "claim"\nstate = "extracted"\nwake = true\n\n[views.open-questions]\nkind = "question"\nstate = "open"\nwake = true\n\n[views.hypotheses-in-play]\nkind = "hypothesis"\nwhere = ["state!=refuted", "state!=parked", "state!=quarantined", "state!=supported"]\nwake = true\n\n[views.findings]\nkind = "finding"\nwhere = ["state!=quarantined", "state!=superseded"]\ncolumns = ["id", "certainty", "consistency", "title"]\ninto = "docs/EVIDENCE.md#findings"\n\n[views.source-counts]\nkind = "source"\ngroup_count = true\ninto = "docs/EVIDENCE.md#source-counts"\n\n[views.claim-counts]\nkind = "claim"\ngroup_count = true\ninto = "docs/EVIDENCE.md#claim-counts"\n\n[views.hypothesis-counts]\nkind = "hypothesis"\ngroup_count = true\ninto = "docs/EVIDENCE.md#hypothesis-counts"\n',
    'mind-topology': '# mind-topology: a private map of one person\'s subjective reality, built in a loop with agents.\n# Applied by `genome init --blueprint mind-topology`; this file is copied verbatim to genome/kinds/.\n[blueprint]\nname = "mind-topology"\nversion = "1"\nsummary = "a private map of one mind: engrams, emotions, shadows, processes and complexes, how they link, where new material lands, how knots untangle"\nmodules = ["core"]\nprivacy = "local"\nroutes = [\n  ["what is in my map right now (counts per state)", "`docs/MAP.md` (generated)"],\n  ["one engram, emotion, shadow or process and everything linked to it", "`genome show <id>`"],\n  ["where does this new material land", "`genome place \\"<the operator\'s words>\\"`"],\n  ["what feeds itself, where the leverage is, what holds two clusters together", "`genome graph cycles | hubs | bridges`"],\n  ["what we discussed, session by session", "`map/sessions.jsonl` (`genome find session`)"],\n]\nplaybook = \'\'\'\n**What this is.** A private, local map of one person\'s inner world, built in dialogue. The operator is the only\nauthority on their own experience. The agent listens, records, asks and proposes structure; the operator confirms.\nThis is reflective self-mapping, not therapy and not diagnosis. If the operator signals crisis (danger to\nthemselves or others, or acute distress), stop mapping, say so plainly and point to human help.\n\n**The map.**\n- `engram`: a unit of experience: a memory, belief, image, sensation, urge, value, story or dream, recorded in\n  the operator\'s own words.\n- `emotion`: a felt state and where it sits in the body.\n- `shadow`: a disowned quality; a "golden" shadow is a disowned strength.\n- `process`: something that runs automatically: a defence, schema, loop, coping move, drive or habit.\n- `complex`: a cluster where engrams pool around one core theme.\n- `insight`: an interpretation. Every agent interpretation lives here and stays `proposed` until the operator\n  confirms it.\n- `session`: the append-only log of each conversation.\n\n**Causal edges.** These are directed, so they can close loops. Which kind may use which (the full list, with enum\nvalues, is `genome blueprint show mind-topology`):\n- engram: `triggers` (→ engram | emotion | process), `feeds` (→ engram | emotion | process | complex: "the more X, the\n  more Y"), `evokes` (→ emotion), `reframes` (→ engram);\n- emotion: `triggers`, `feeds`, `masks` (→ emotion);\n- process: `triggers`, `feeds`, `defends_against` (→ engram | emotion | shadow);\n- shadow: `fuels` (→ process | emotion), `shows_as` (→ engram | emotion).\n\n**Structure.** `pools_into`, `integrates_into`, `core_engram`, `part_of`, `held_in`.\n\n**Symmetric.** `correlates_with`, `contradicts`.\n\n**What goes where.** A thought, belief, memory or image in the operator\'s words is an `engram`. Something the operator\nsays they *do* ("I avoid rooms like that") is a `process` with `type=behaviour`, which names what happens and claims\nnothing about why. Only the operator\'s own causal statements become edges. An edge you inferred goes into an\n`insight` first and is linked only when the operator agrees; `graph cycles` finds a loop only once its closing edge\nexists, so a suspected loop is a proposed insight until then.\n\n**The loop, one session at a time.**\n1. `genome wake`. The QUEUE lists unmapped engrams, knots being untangled and insights awaiting the operator.\n2. Open the session: `genome new session --title "<topic>" --set mode=capture`, which returns SE-n.\n3. For each piece of material:\n   1. Run `genome place "<the operator\'s words>"` to get the nearest entries and candidate edges.\n   2. Record the material verbatim: `genome new engram --title "<short handle>" --set statement="<their words>"\n      --link from_session=SE-n`. Add `--link pools_into=CX-k` and the others only when the operator agrees.\n      Never write an interpretation into `statement`. For several pieces at once, one call:\n      `genome new --batch -` with one JSON object per line (see below).\n   3. Ask, don\'t tell: "does this connect to EN-12 (…)?" Then link what the operator confirms:\n      `genome link EN-40 triggers EM-3`.\n   4. When the material is placed and linked, `genome move EN-40 mapped`.\n4. Look for structure, and show the operator the result, not the method:\n   - `genome graph cycles` finds knots that feed themselves, e.g. a fear that triggers an avoidance that feeds\n     the fear;\n   - `genome graph hubs` finds the entries most things pass through, the leverage points;\n   - `genome graph bridges` finds a single link holding two clusters together, where an integration or a split\n     happens;\n   - `genome graph gaps` finds two entries sharing neighbours but never linked, a question worth asking;\n   - `genome graph neighbors EN-40 --depth 2` shows the local terrain of one entry.\n5. Propose an interpretation, never assert one: `genome new insight --title "…" --set statement="…" --set\n   type=pattern --set origin=agent --link about=EN-12,PR-3 --link from_session=SE-n`.\n6. Untangle one knot at a time:\n   - `genome move EN-12 untangling`, then work the knot with the operator;\n   - when the operator says it has loosened, they run `genome move EN-12 untangled --evidence SE-n --human <name>`;\n   - integration, owning a shadow and transforming a process are human-only too.\n7. Close: `genome move SE-n closed`, then `genome close`. The map stays on this machine: `close` refuses if the\n   repo has a git remote.\n\n**Token rules.** Use `show`, `find`, `graph` and `place`, which return ids and one-line summaries. Never read the\nwhole `map/` directory. Batch several new entries in one call with `genome new --batch -`, one JSON object per\nline: `{"kind":"engram","title":"…","set":{"statement":"…"},"link":{"from_session":"SE-0001","triggers":"@2"}}`.\n`@N` names the entity made by line N of the input (1-based); a link value is an id, `"A,B"`, or a list, and may mix\n`@N` with ids. Fields are single-line; long prose goes in `"body"`.\n\'\'\'\n\n[kinds.engram]\npath = "map/engrams"\nid = "EN-{n:04}"\nmutability = "amendable"\nfields = { statement = "text!", modality = "enum:memory|belief|image|sensation|urge|value|story|dream|fantasy", valence = "enum:-3..3", intensity = "int:0..10", age = "text", source = "enum:session|journal|dream|body|observation|other", confidence = "enum:tentative|felt|certain" }\nstates = ["captured", "mapped", "untangling", "untangled", "integrated", "parked"]\ntransitions = { captured = ["mapped", "parked"], mapped = ["untangling", "integrated", "parked"], untangling = ["untangled", "mapped", "parked"], untangled = ["integrated", "mapped"], integrated = ["mapped"], parked = ["captured"] }\nevidence_on = ["untangled", "integrated"]\nhuman_only = ["untangled", "integrated"]\n[kinds.engram.relations]\ntriggers = { to = "engram|emotion|process", inverse = "triggered-by" }\nfeeds = { to = "engram|emotion|process|complex", inverse = "fed-by" }\nevokes = { to = "emotion", inverse = "evoked-by" }\npools_into = { to = "complex", inverse = "pools" }\nintegrates_into = { to = "engram|complex", inverse = "integrates" }\nreframes = { to = "engram", inverse = "reframed-by" }\ncorrelates_with = { to = "engram", symmetric = true }\ncontradicts = { to = "engram", symmetric = true }\nfrom_session = { to = "session", graph = false, inverse = "captured" }\n\n[kinds.emotion]\npath = "map/emotions"\nid = "EM-{n:03}"\nfields = { family = "enum:fear|anger|sadness|joy|disgust|shame|guilt|surprise|longing|other!", intensity = "int:0..10", body = "text" }\nstates = ["noticed", "felt", "metabolised"]\ntransitions = { noticed = ["felt"], felt = ["metabolised", "noticed"], metabolised = ["felt"] }\nevidence_on = ["metabolised"]\nhuman_only = ["metabolised"]\n[kinds.emotion.relations]\ntriggers = { to = "engram|emotion|process", inverse = "triggered-by" }\nfeeds = { to = "engram|emotion|process|complex", inverse = "fed-by" }\nmasks = { to = "emotion", inverse = "masked-by" }\nfrom_session = { to = "session", graph = false, inverse = "captured" }\n\n[kinds.shadow]\npath = "map/shadows"\nid = "SH-{n:03}"\nfields = { trait = "text!", golden = "bool", projected_onto = "text" }\nstates = ["suspected", "recognised", "owned", "integrated"]\ntransitions = { suspected = ["recognised"], recognised = ["owned", "suspected"], owned = ["integrated"] }\nevidence_on = ["owned", "integrated"]\nhuman_only = ["recognised", "owned", "integrated"]\n[kinds.shadow.relations]\nfuels = { to = "process|emotion", inverse = "fuelled-by" }\nshows_as = { to = "engram|emotion", inverse = "shows" }\nheld_in = { to = "complex", inverse = "holds" }\nfrom_session = { to = "session", graph = false, inverse = "captured" }\n\n[kinds.process]\npath = "map/processes"\nid = "PR-{n:03}"\nfields = { type = "enum:behaviour|defence|schema|loop|coping|drive|habit!", mechanism = "text", protects = "text", cost = "text" }\nstates = ["suspected", "observed", "interrupted", "transformed"]\ntransitions = { suspected = ["observed"], observed = ["interrupted", "suspected"], interrupted = ["transformed", "observed"] }\nevidence_on = ["interrupted", "transformed"]\nhuman_only = ["transformed"]\n[kinds.process.relations]\ntriggers = { to = "engram|emotion|process", inverse = "triggered-by" }\nfeeds = { to = "engram|emotion|process|complex", inverse = "fed-by" }\ndefends_against = { to = "engram|emotion|shadow", inverse = "defended-by" }\nfrom_session = { to = "session", graph = false, inverse = "captured" }\n\n[kinds.complex]\npath = "map/complexes"\nid = "CX-{n:03}"\nfields = { core = "text!", origin = "text" }\nstates = ["forming", "named", "loosening", "resolved"]\ntransitions = { forming = ["named"], named = ["loosening"], loosening = ["resolved", "named"] }\nevidence_on = ["resolved"]\nhuman_only = ["resolved"]\n[kinds.complex.relations]\ncore_engram = { to = "engram", max = 1, inverse = "core-of" }\npart_of = { to = "complex", inverse = "contains" }\n\n[kinds.insight]\npath = "map/insights"\nid = "IN-{n:04}"\nfields = { statement = "text!", type = "enum:pattern|reframe|link|leverage|question!", origin = "enum:operator|agent!" }\nstates = ["proposed", "confirmed", "rejected"]\ntransitions = { proposed = ["confirmed", "rejected"], rejected = ["proposed"] }\nhuman_only = ["confirmed"]\n[kinds.insight.relations]\nabout = { to = "*", min = 1, graph = false, inverse = "insight" }\nfrom_session = { to = "session", graph = false, inverse = "captured" }\n\n[kinds.session]\npath = "map/sessions.jsonl"\nstore = "jsonl"\nid = "SE-{n:04}"\nfields = { mode = "enum:capture|map|untangle|integrate|review!", summary = "text" }\nstates = ["open", "closed"]\ntransitions = { open = ["closed"], closed = ["open"] }\n\n[views.unmapped]\nkind = "engram"\nstate = "captured"\nwake = true\n\n[views.untangling]\nkind = "engram"\nstate = "untangling"\nwake = true\n\n[views.awaiting-operator]\nkind = "insight"\nstate = "proposed"\nwake = true\n\n[views.engram-counts]\nkind = "engram"\ngroup_count = true\ninto = "docs/MAP.md#engram-counts"\n\n[views.process-counts]\nkind = "process"\ngroup_count = true\ninto = "docs/MAP.md#process-counts"\n\n[views.shadow-counts]\nkind = "shadow"\ngroup_count = true\ninto = "docs/MAP.md#shadow-counts"\n\n[views.complexes]\nkind = "complex"\ncolumns = ["id", "state", "title", "core"]\ninto = "docs/MAP.md#complexes"\n',
    'ontology': '# ontology: mapping the architecture of reality. Axioms anchor, theses derive, witnesses corroborate, joints set the agenda.\n# Shaped on HoloOS (status ladder, theory_doc_v2 derivation patterns, 5-phase catalyst protocol) without its content.\n[blueprint]\nname = "ontology"\nversion = "1"\nsummary = "axioms → derivations → theses on the ladder ai-draft → canonical-hypothesis → canonical (human-only); witnesses corroborate but never ground; open joints are the agenda"\nmodules = ["core", "records"]\nroutes = [\n  ["what is canonical, what is hypothesis, what is draft", "`docs/ONTOLOGY.md` (generated)"],\n  ["what to work on next (open joints by priority)", "`genome view agenda` / wake QUEUE"],\n  ["how a thesis is derived, back to its axioms", "`genome graph path TH-n AX-n` / `genome show TH-n`"],\n  ["incoming catalyst and where each is in the protocol", "`ontology/catalysts.jsonl` (`genome find catalyst`)"],\n]\nplaybook = \'\'\'\n**What this is.** An ontology built by derivation.\n- `axiom`: a trusted anchor. An agent may *propose* one (it stays `proposed`) and derive from it; only a human\n  adopts it, and a human reviews the chain before anything above `ai-draft` stands.\n- `thesis`: a structural claim. It climbs the ladder **ai-draft → canonical-hypothesis → canonical**:\n  - every agent-written thesis starts at `ai-draft`;\n  - `canonical-hypothesis` needs a `derived_by` derivation and, as evidence, a red-team thesis of this very thesis\n    (`red_team_of` pointing at it). Write the antithesis first; if it stands unanswered, open a `joint` for it rather\n    than treating the thesis as having survived;\n  - `canonical` is human-only.\n- `derivation`: the reified "derives from" edge. Its premises are axioms, theses or concepts, and its `pattern`\n  is one of structural-mirroring, fractal-recursion, invariant-vs-decoration, witness-corroboration or none.\n- `witness`: external corroboration (a tradition, a science, a text), kept in its own voice: `quote` plus\n  `locator`. It starts `noted`, which means "quoted but not checked" (a quote recalled from memory stays `noted`);\n  `verified` needs evidence that the words were checked against the text; only then `incorporated`.\n- `concept`: a holon or category in a holarchy (`is_a`, `part_of`, symmetric `mirrors`).\n- `joint`: an open question. Open joints are the research agenda.\n\n**Rules the schema enforces.**\n- **Derive, don\'t borrow.** A witness can corroborate a thesis (`corroborated_by`) but cannot be a premise. A\n  derivation\'s `from` does not accept witnesses.\n- **Keep thesis and antithesis.** A red-team is a thesis in its own right (`red_team_of`), written and kept. If the\n  antithesis wins, the red-teamed thesis moves to `superseded` with a `notice` (it is never deleted). If it\n  survives, it advances (loop step 4), citing the antithesis as evidence.\n- **Supersession cascades.** A derivation built on a superseded premise is flagged (E510) and moves to\n  `suspended`. A thesis derived by a suspended derivation is flagged in turn and goes back to `ai-draft` to be\n  re-derived.\n- **Scope is declared.** Every thesis says whether it claims to hold cosmologically, within a domain, or locally.\n\n**Catalyst protocol.** A `catalyst` (append-only) is any incoming input: a user prompt, a red-team, a witness\nincorporation, an open-joint resolution or a framework evolution. It walks five phases, each enforced on write:\n1. `received`.\n2. `articulated`: the claim is stated.\n3. `red-teamed`: thesis and antithesis both recorded; evidence is the antithesis id.\n4. `corroborated`: witnesses checked; evidence is the id of a witness that is `verified` or `incorporated` (an unchecked\n   one is refused, so a recalled quote cannot pass for corroboration). If the witness cannot be checked, the catalyst\n   stays at `red-teamed` and in the queue until someone with the text verifies it; do not `drop` it, which says the\n   input was abandoned. Everything else it produced is already in the graph.\n5. `placed`: the result sits in the graph; evidence is the thesis or joint it produced.\n\n**The loop.**\n1. `genome wake`. The QUEUE shows high-priority open joints, theses awaiting human review, and catalysts in flight.\n2. Log the input: `genome new catalyst --title "…" --set type=user-prompt`. When the thesis exists, link it:\n   `genome link CA-0001 targets TH-0001`, and at the end `genome link CA-0001 produced TH-0001,TH-0002,WI-0001,J-0001`\n   (a catalyst cannot be `placed` before it has produced something).\n3. Draft: `genome new thesis --title "…" --set statement="…" --set scope=domain --link about=CN-4 --link raises=J-0012`.\n   Then derive: `genome new derivation --title "…" --set pattern=structural-mirroring --set steps="…" --link from=AX-001,TH-0003`\n   and `genome link TH-0009 derived_by DV-0004`.\n4. Red-team: write the antithesis, `genome new thesis … --link red_team_of=TH-0009`. Then\n   `genome move DV-0004 red-teamed --evidence TH-0010` and `genome move TH-0009 canonical-hypothesis --evidence TH-0010`.\n5. Corroborate: `genome new witness --title "…" --set tradition="…" --set quote="…" --set locator="…"`, then\n   `genome link TH-0009 corroborated_by WI-0002`.\n6. Place it in the architecture:\n   - `genome graph neighbors TH-0009 --depth 2` shows its surroundings;\n   - `genome graph path TH-0009 AX-001` checks the derivation chain;\n   - `genome graph hubs --kind concept` shows the load-bearing concepts;\n   - `genome graph gaps --kind concept` shows structure implied but not stated, which becomes a new joint;\n   - `genome graph cycles` shows circular derivations, which must be broken.\n7. Before retiring or superseding anything, preview it: `genome impact AX-001 --to retired` lists each entity that\n   would be flagged, hop by hop, with the exact `genome move` that clears each hop. It changes nothing.\n8. Resolve joints with evidence: `genome move J-0012 resolved --evidence TH-0009 && genome link J-0012 resolved_by TH-0009`.\n9. `genome close`. Promotion is the operator\'s, in this order: `genome move DV-0004 accepted --evidence <review> --human\n   <name>`, then `genome move TH-0009 canonical --evidence <review> --human <name>`. (The schema requires a\n   derivation to exist; accepting it first is the review order, not enforced.) Several relations in one `new`: repeat the\n   flag, `--link about=CN-4 --link raises=J-12`; commas separate targets of one relation only.\n\'\'\'\n\n[kinds.axiom]\npath = "ontology/axioms"\nid = "AX-{n:03}"\nmutability = "amendable"\nfields = { statement = "text!", rationale = "text" }\nstates = ["proposed", "adopted", "retired"]\ntransitions = { proposed = ["adopted"], adopted = ["retired"], retired = ["adopted"] }\nhuman_only = ["adopted", "retired"]\n\n[kinds.thesis]\npath = "ontology/theses"\nid = "TH-{n:04}"\nmutability = "amendable"\nfields = { statement = "text!", scope = "enum:cosmological|domain|local!", coordinate = "text", notice = "text" }\nstates = ["ai-draft", "canonical-hypothesis", "canonical", "superseded"]\ninitial = "ai-draft"\ntransitions = { ai-draft = ["canonical-hypothesis", "superseded"], canonical-hypothesis = ["canonical", "ai-draft", "superseded"], canonical = ["superseded"] }\nevidence_on = ["canonical-hypothesis", "canonical", "superseded"]\nevidence_ref = { canonical-hypothesis = "thesis?red_team_of=@self" }\nhuman_only = ["canonical"]\nquarantine = "ai-draft"\n[kinds.thesis.relations]\nderived_by = { to = "derivation", required_in = ["canonical-hypothesis", "canonical"], taint = ["suspended", "rejected"], inverse = "concludes" }\nred_team_of = { to = "thesis", inverse = "red-teamed-by" }\nsupersedes = { to = "thesis", inverse = "superseded-by" }\ncorroborated_by = { to = "witness", inverse = "corroborates" }\nabout = { to = "concept", inverse = "described-by" }\nraises = { to = "joint", inverse = "raised-by" }\n\n[kinds.derivation]\npath = "ontology/derivations"\nid = "DV-{n:04}"\nfields = { pattern = "enum:structural-mirroring|fractal-recursion|invariant-vs-decoration|witness-corroboration|none!", steps = "text" }\nstates = ["drafted", "red-teamed", "accepted", "rejected", "suspended"]\ntransitions = { drafted = ["red-teamed"], red-teamed = ["accepted", "rejected", "drafted"], suspended = ["drafted"], rejected = ["drafted"] }\nevidence_on = ["red-teamed", "accepted"]\nhuman_only = ["accepted"]\nquarantine = "suspended"\n[kinds.derivation.relations]\nfrom = { to = "axiom|thesis|concept", min = 1, taint = ["superseded", "retired"], inverse = "premise-of" }\n\n[kinds.concept]\npath = "ontology/concepts"\nid = "CN-{n:04}"\nfields = { definition = "text!", level = "text", realm = "text" }\n[kinds.concept.relations]\nis_a = { to = "concept", inverse = "kind" }\npart_of = { to = "concept", inverse = "has-part" }\nmirrors = { to = "concept", symmetric = true }\ndefined_in = { to = "thesis|axiom", max = 1, graph = false, inverse = "defines" }\n\n[kinds.witness]\npath = "ontology/witnesses"\nid = "WI-{n:04}"\nmutability = "amendable"\nfields = { tradition = "text!", quote = "text!", locator = "text" }\nstates = ["noted", "verified", "incorporated"]\ntransitions = { noted = ["verified"], verified = ["incorporated"] }\nevidence_on = ["verified", "incorporated"]\n\n[kinds.joint]\npath = "ontology/joints"\nid = "J-{n:04}"\nfields = { question = "text!", priority = "enum:high|medium|low!", series = "text" }\nstates = ["open", "partially-resolved", "resolved", "dissolved"]\ntransitions = { open = ["partially-resolved", "resolved", "dissolved"], partially-resolved = ["resolved", "dissolved", "open"], resolved = ["open"] }\nevidence_on = ["partially-resolved", "resolved", "dissolved"]\n[kinds.joint.relations]\nresolved_by = { to = "thesis", max = 1, required_in = ["resolved"], inverse = "resolves" }\nconcerns = { to = "concept|thesis|axiom", inverse = "joint" }\n\n[kinds.catalyst]\npath = "ontology/catalysts.jsonl"\nstore = "jsonl"\nid = "CA-{n:04}"\nfields = { type = "enum:user-prompt|red-team|witness-incorporation|open-joint-resolution|framework-evolution!", summary = "text" }\nstates = ["received", "articulated", "red-teamed", "corroborated", "placed", "dropped"]\ntransitions = { received = ["articulated", "dropped"], articulated = ["red-teamed", "dropped"], red-teamed = ["corroborated", "dropped"], corroborated = ["placed"] }\nevidence_on = ["red-teamed", "corroborated", "placed"]\nevidence_ref = { corroborated = "witness?state=verified|incorporated" }\n[kinds.catalyst.relations]\ntargets = { to = "thesis|joint|concept|axiom", graph = false, inverse = "catalysed-by" }\nproduced = { to = "thesis|witness|joint|concept|derivation", required_in = ["placed"], graph = false, inverse = "produced-by" }\n\n[views.agenda]\nkind = "joint"\nwhere = ["priority=high", "state!=resolved", "state!=dissolved"]\nwake = true\n\n[views.awaiting-review]\nkind = "thesis"\nstate = "canonical-hypothesis"\nwake = true\n\n[views.unverified-witnesses]\nkind = "witness"\nstate = "noted"\nwake = true\n\n[views.catalyst-in-flight]\nkind = "catalyst"\nwhere = ["state!=placed", "state!=dropped"]\nwake = true\n\n[views.thesis-counts]\nkind = "thesis"\ngroup_count = true\ninto = "docs/ONTOLOGY.md#thesis-counts"\n\n[views.joint-counts]\nkind = "joint"\ngroup_count = true\ninto = "docs/ONTOLOGY.md#joint-counts"\n\n[views.canon]\nkind = "thesis"\nstate = "canonical"\ncolumns = ["id", "scope", "title"]\ninto = "docs/ONTOLOGY.md#canon"\n',
    'venture-pipeline': '# venture-pipeline: the three lanes that turn a signal into paid work (job, freelance, architecture). Each lane keeps its\n# own ladder, because the rules differ (a lead needs a named person; an application does not). One append-only outcome\n# ledger, shared by all three, is the only input to the lane score.\n[blueprint]\nname = "venture-pipeline"\nversion = "1"\nsummary = "job applications, freelance gigs and architecture leads, each on its own ladder; triggers are not leads; outcomes are an append-only ledger that drives the lane score"\nmodules = ["core", "records"]\nroutes = [\n  ["which lane loses hours this week, and why", "`docs/PIPELINE.md` (lane score, written weekly by the score script from the outcome ledger)"],\n  ["which applications and gigs need a human now", "`genome view agenda-applications` / `agenda-gigs` / wake QUEUE"],\n  ["what is a trigger and which architecture items are not leads", "`genome view triggers` (never counted)"],\n  ["every send, reply, interview, offer and win, in order", "`pipeline/outcomes.jsonl` (`genome find outcome`)"],\n  ["who a lead is, and whether their CRM record exists", "`genome find contact` (crm_ref → relationship-crm)"],\n]\nplaybook = \'\'\'\n**What this is.** The revenue pipeline for three lanes. A lane is a ladder of states for one kind of item; the kinds do\nnot share a ladder, because the gates differ. Everything that is sent, answered or won is one row in `outcome`.\n\n- `application` (job lane, career-pipeline): a remote job application. States follow career-pipeline\'s\n  `application_status_transitions`: discovered, applied, responded, interviewed, offered, closed-won, rejected, withdrawn.\n- `gig` (freelance lane, freelance-agency): an inbound or outbound freelance lead. States follow freelance-agency\'s\n  statuses: new, contacted, negotiating, closed-won, closed-lost, stale.\n- `lead` (architecture lane, architectural-leads): a signal that may yield a person. It starts as `trigger`.\n- `contact`: a named human, with the `crm_ref` of their relationship-crm record. No state.\n- `outcome` (append-only ledger): one row per send, failure, reply, interview, offer, win or loss. The ledger is the\n  only input to the lane score. Other event kinds in the ventures\' own logs (score, track, enrich, research and so on)\n  are not outcomes and do not belong here.\n\n**Rules the schema enforces.**\n- **A trigger is not a lead** (architectural-leads DA-RG-052). A `lead` in `trigger` has no person. It cannot pass\n  `new` to `contacted` without one: `contacted` and every later state need a `person` relation whose contact has a `crm_ref`.\n  Counts reported as pipeline come from `new` and later only.\n- **Sending is evidence.** `applied`, `contacted` and `new`-to-`contacted` moves need an `outcome` row about the item\n  (evidence_ref). Write the row first, then move the item.\n- **Wins are human-only.** `closed-won` (gig, application) and `won` in the ledger are set only with `--human`: a paid\n  engagement or an accepted offer is confirmed by the operator, not inferred from a reply.\n- **The ledger is append-only.** A mistaken row is corrected by a new row, never by an edit.\n\n**Lane score (revenue plan §3).** Score = P(first paid reply within 30 days) × first ticket ÷ days to cash, per lane,\ncomputed weekly from the `outcome` rows. The score is computed by a script, not the kernel; its result is written into\n`docs/PIPELINE.md`. The lowest-scoring lane loses hours first, and no lane closes by default.\n\n**Gates before auto-send.** None is passed yet. Sends run by hand, under per-lane daily caps, and each one is logged\nas an `outcome` row. Automatic sending waits for the revenue plan\'s §6 gates.\n\n**Mapping from the ventures\' own ladders (for a later migration; this blueprint moves no data).**\n- career-pipeline `application_statuses` → `application` states, one to one.\n- freelance-agency statuses `new`, `contacted`, `negotiating`, `closed-won`, `closed-lost`, `stale` → `gig` states, one to one.\n- freelance-agency event kinds `outcome`, `outreach`, `rejected`, `send_failed` → `outcome` states `sent`, `failed`, `lost`.\n- architectural-leads items with no named person stay `trigger`; the 301 current items are triggers, not leads.\n\'\'\'\n\n[kinds.application]\npath = "pipeline/applications"\nid = "AP-{n:04}"\nfields = { employer = "text!", country = "text", source = "text", url = "text" }\nstates = ["discovered", "applied", "responded", "interviewed", "offered", "closed-won", "rejected", "withdrawn", "stale"]\ninitial = "discovered"\ntransitions = { discovered = ["applied", "rejected", "withdrawn", "stale"], applied = ["responded", "interviewed", "rejected", "withdrawn"], responded = ["interviewed", "offered", "rejected", "withdrawn"], interviewed = ["offered", "rejected", "withdrawn"], offered = ["closed-won", "rejected", "withdrawn"], stale = ["discovered"] }\nevidence_on = ["applied"]\nevidence_ref = { applied = "outcome?about=@self" }\nhuman_only = ["closed-won"]\n[kinds.application.relations]\nperson = { to = "contact", max = 1, inverse = "contact-of" }\n\n[kinds.gig]\npath = "pipeline/gigs"\nid = "GG-{n:04}"\nfields = { client = "text", domain = "enum:freelance|consulting|product|inbound!", value = "text", channel = "text" }\nstates = ["new", "contacted", "negotiating", "closed-won", "closed-lost", "stale"]\ninitial = "new"\ntransitions = { new = ["contacted", "stale"], contacted = ["negotiating", "closed-lost", "stale"], negotiating = ["closed-won", "closed-lost", "stale"], stale = ["new"] }\nevidence_on = ["contacted"]\nevidence_ref = { contacted = "outcome?about=@self" }\nhuman_only = ["closed-won"]\n[kinds.gig.relations]\nperson = { to = "contact", max = 1, inverse = "contact-of" }\n\n[kinds.lead]\npath = "pipeline/leads"\nid = "LD-{n:04}"\nfields = { signal_stream = "enum:builder|smb|homeowner!", location = "text", score = "text" }\nstates = ["trigger", "new", "contacted", "replied", "negotiating", "closed-won", "closed-lost", "stale"]\ninitial = "trigger"\ntransitions = { trigger = ["new", "stale"], new = ["contacted", "stale"], contacted = ["replied", "closed-lost", "stale"], replied = ["negotiating", "closed-won", "closed-lost"], negotiating = ["closed-won", "closed-lost", "stale"], stale = ["trigger"] }\nevidence_on = ["contacted"]\nevidence_ref = { contacted = "outcome?about=@self" }\nhuman_only = ["closed-won"]\n[kinds.lead.relations]\nperson = { to = "contact", max = 1, required_in = ["contacted", "replied", "negotiating", "closed-won", "closed-lost"], inverse = "contact-of" }\n\n[kinds.contact]\npath = "pipeline/contacts"\nid = "CT-{n:04}"\nfields = { name = "text!", crm_ref = "text!" }\n\n[kinds.outcome]\nstore = "jsonl"\npath = "pipeline/outcomes.jsonl"\nid = "OU-{n:04}"\nmutability = "append-only"\nfields = { venture = "enum:job|freelance|architecture!", channel = "text", amount = "text", note = "text" }\nstates = ["sent", "failed", "reply", "interview", "offer", "won", "lost"]\ninitial = "sent"\ntransitions = { sent = ["failed", "reply", "interview", "offer", "won", "lost"], reply = ["interview", "offer", "won", "lost"], interview = ["offer", "won", "lost"], offer = ["won", "lost"] }\nhuman_only = ["won"]\n[kinds.outcome.relations]\nabout = { to = "application|gig|lead", max = 1, inverse = "outcome" }\n\n[views.agenda-applications]\nkind = "application"\nwhere = ["state!=discovered", "state!=applied", "state!=rejected", "state!=withdrawn", "state!=closed-won", "state!=stale"]\nwake = true\n\n[views.agenda-gigs]\nkind = "gig"\nwhere = ["state!=new", "state!=closed-won", "state!=closed-lost", "state!=stale"]\nwake = true\n\n[views.triggers]\nkind = "lead"\nstate = "trigger"\nwake = false\n\n[views.counts-applications]\nkind = "application"\ngroup_count = true\ninto = "docs/PIPELINE.md#application-counts"\n\n[views.counts-gigs]\nkind = "gig"\ngroup_count = true\ninto = "docs/PIPELINE.md#gig-counts"\n\n[views.counts-leads]\nkind = "lead"\ngroup_count = true\ninto = "docs/PIPELINE.md#lead-counts"\n',
}


# ---------------------------------------------------------------- main

def main() -> None:
    p = argparse.ArgumentParser(prog="genome", description=__doc__.splitlines()[0])
    p.add_argument("--version", action="version", version=f"genome {VERSION}")
    sub = p.add_subparsers(dest="cmd", required=True)

    def add(name, fn, help_, *aliases):
        s = sub.add_parser(name, help=help_, aliases=list(aliases))
        s.set_defaults(fn=fn, json=False)
        if name in JSON_CMDS:
            s.add_argument("--json", action="store_true", help="machine-readable output (one JSON document)")
        return s

    s = add("init", cmd_init, "scaffold the genome (never overwrites)")
    s.add_argument("--profile", choices=PROFILES)
    s.add_argument("--modules", help="comma list, e.g. records,research")
    s.add_argument("--blueprint", action="append", metavar="NAME|FILE", help="apply a blueprint (kinds, views, playbook, routes, seed); repeatable or comma list; works on an existing genome")
    s.add_argument("--force", action="store_true")
    add("modules", cmd_modules, "show which modules are on")
    s = add("lint", cmd_lint, "check every enabled module (exit 2 on error)")
    s.add_argument("--advisory", action="store_true")
    s.add_argument("--only", choices=MODULES)
    s.add_argument("--code", nargs="+", help="only these codes, e.g. E303 W007")
    s.add_argument("--all", action="store_true", help="print every finding (default: 5 per code)")
    add("doctor", cmd_doctor, "staleness, append-only violations, unapplied rulings, running-job edits")
    add("emit", cmd_emit, "regenerate every genome zone (records, ID map, worklog index); close does this too")
    s = add("wake", cmd_wake, "one-call orientation: state, resume, asks, jobs, inbox, health")
    s.add_argument("--write", action="store_true", help="regenerate the handoff zone (was `handoff --write`)")
    s = add("ask", cmd_ask, "question → the owning sections (path:lines)")
    s.add_argument("question", nargs="+")
    s.add_argument("--k", type=int, default=6)
    s.add_argument("--all", action="store_true", help="search the cards of every federated repo (repo:<name>#<class> pointers)")
    s.add_argument("--index", action="store_true", help="rank with BM25 from .genome/index.db (also searches entities)")
    s.add_argument("--show", type=int, nargs="?", const=60, default=0, help="print the best section (N lines)")
    s = add("new", cmd_new, "create an entity of a declared kind")
    s.add_argument("kind", nargs="?"); s.add_argument("--title"); s.add_argument("--set", action="append", metavar="FIELD=VALUE")
    s.add_argument("--link", action="append", metavar="REL=ID", help="an edge set at creation (repeatable; REL=A,B for several)")
    s.add_argument("--batch", metavar="FILE|-", help='JSON lines, e.g. {"kind":"claim","title":"t","set":{"quote":"q"},"link":{"cites":"@2","subject":"CO-1,CO-2"}}; @N = line N of the input (forward or back); all or nothing')
    s.add_argument("--body"); s.add_argument("--agent")
    s = add("move", cmd_move, "move an entity to a state (transitions, evidence and human-only enforced)")
    s.add_argument("id", help="an id, or several comma-separated (all checked before any moves)")
    s.add_argument("state"); s.add_argument("--evidence", help="existing path | entity id | commit:<sha> | URL"); s.add_argument("--agent")
    s.add_argument("--human", metavar="NAME", help="sign-off by a person (required for human-only states)")
    s = add("set", cmd_set, "update an entity's fields: set <id> --set field=value (types enforced)")
    s.add_argument("id"); s.add_argument("--set", action="append", metavar="FIELD=VALUE"); s.add_argument("--agent")
    s = add("link", cmd_link, "add a typed relation: link <a> <relation> <b>")
    s.add_argument("a"); s.add_argument("rel"); s.add_argument("b")
    s = add("unlink", lambda a: cmd_link(a, True), "remove a typed relation")
    s.add_argument("a"); s.add_argument("rel"); s.add_argument("b")
    s = add("show", cmd_show, "entities: fields, relations both ways, recent history (show A,B,C reads several in one call)")
    s.add_argument("id")
    s = add("find", cmd_find, "entities of a kind: find <kind> [--state S] [--where 'field op value']")
    s.add_argument("kind"); s.add_argument("--state"); s.add_argument("--where", action="append")
    s.add_argument("--limit", type=int, default=50)
    s = add("view", cmd_view, "print a saved view ([views.<name>] in genome.toml)")
    s.add_argument("name")
    s = add("impact", cmd_impact, "preview what moving <id> to a state would flag (E510), hop by hop, with the commands that follow")
    s.add_argument("id"); s.add_argument("--to", help="the state it would enter (default: the one state its pointers treat as taint)")
    s = add("graph", cmd_graph, "typed-edge queries: neighbors | path | hubs | cycles | bridges | gaps")
    s.add_argument("query"); s.add_argument("a", nargs="?"); s.add_argument("b", nargs="?")
    s.add_argument("--depth", type=int, default=2); s.add_argument("--top", type=int, default=10)
    s.add_argument("--kind", help="project onto one kind: K nodes linked directly or through one non-K node")
    s.add_argument("--across", metavar="REL|FIELD", help="namespace nodes by a relation's target or a field; keep only what crosses namespaces")
    s = add("blueprint", cmd_blueprint, "blueprints: list | show NAME | new NAME [--from BASE] | check [NAME|FILE]")
    s.add_argument("bp_cmd", choices=["list", "show", "new", "check"]); s.add_argument("name", nargs="?")
    s.add_argument("--from", dest="base", metavar="BASE", help="new: extend this blueprint")
    s.add_argument("--toml", action="store_true", help="show: the raw file"); s.add_argument("--playbook", action="store_true", help="show: the loop only")
    s.add_argument("--keep", action="store_true", help="check: keep the scratch genome")
    s = add("place", cmd_place, "where does this text land: candidate kinds, nearest entities, proposed edges")
    s.add_argument("text", nargs="+"); s.add_argument("--k", type=int, default=8)
    s = add("index", cmd_index, "build or refresh the search/graph cache (.genome/index.db)")
    s.add_argument("--rebuild", action="store_true")
    s = add("card", cmd_card, "write this repo's card (a small summary) to the cards cache")
    s.add_argument("--stdout", action="store_true"); s.add_argument("--out")
    add("federate", cmd_federate, "meta root: build every member repo's card into the cache (reads trees, writes none)")
    s = add("resolve", cmd_resolve, "repo:<name>#<class> → the file in that repo")
    s.add_argument("pointer")
    s = add("verify", cmd_verify, "record that a manual was reviewed against the code it covers (sets `verified`)")
    s.add_argument("doc"); s.add_argument("--reviewed", action="store_true"); s.add_argument("--sha"); s.add_argument("--covers")
    s = add("upgrade", cmd_upgrade, "compare this repo's CLI with the skill's copy; --apply swaps it in")
    s.add_argument("--apply", action="store_true"); s.add_argument("--accept-patch-loss", action="store_true")
    add("migrate", cmd_migrate, "bring genome.toml to this CLI's schema_version")
    s = add("close", cmd_close, "iteration close: emit, lint, secrets, gate, named paths")
    s.add_argument("--no-gate", action="store_true")
    s = add("handoff", cmd_handoff, "alias of `wake --write`: the state snapshot from git + register + worklog")
    s.add_argument("--write", action="store_true")
    s = add("status", cmd_status, "supervised register transition")
    s.add_argument("id"); s.add_argument("status")
    s.add_argument("--evidence"); s.add_argument("--note"); s.add_argument("--agent")
    s = add("plan", lambda a: cmd_plan(a, "plans"), "mint a dated plan")
    s.add_argument("title")
    s = add("audit", lambda a: cmd_plan(a, "audits"), "mint a dated audit")
    s.add_argument("title")
    s = add("archive", cmd_archive, "archive a doc (or one --section of it) with a reason")
    s.add_argument("path"); s.add_argument("--reason", required=True)
    s.add_argument("--section"); s.add_argument("--generation"); s.add_argument("--by")
    s = add("log", cmd_log, "worklog: append an entry (file form) or create the next numbered file")
    s.add_argument("entry"); s.add_argument("--body"); s.add_argument("--agent")
    s.add_argument("--body-file", help="the entry body from a markdown file (`-` = stdin)")
    s = add("q", cmd_q, "operator questions: add | rule | apply | withdraw | list")
    s.add_argument("q_cmd", choices=["add", "rule", "apply", "withdraw", "list"])
    s.add_argument("id", nargs="?"); s.add_argument("text", nargs="*")
    s.add_argument("--applied", nargs="+"); s.add_argument("--open", action="store_true")

    s = add("rec", cmd_rec, "records: recon | new | amend | supersede | merge | retire | list | show | emit")
    rs = s.add_subparsers(dest="rec_cmd", required=True)
    r = rs.add_parser("recon"); r.add_argument("keywords", nargs="+")
    r = rs.add_parser("new"); r.add_argument("kind", choices=["ad", "rg", "AD", "RG"]); r.add_argument("title")
    r.add_argument("--recon", required=True); r.add_argument("--orthogonal", required=True)
    r.add_argument("--description"); r.add_argument("--severity", default="High")
    r = rs.add_parser("amend"); r.add_argument("id"); r.add_argument("--title", required=True)
    r.add_argument("--reason", required=True); r.add_argument("--body"); r.add_argument("--body-file")
    r.add_argument("--set", nargs="+", metavar="FIELD=VALUE")
    r = rs.add_parser("supersede"); r.add_argument("ids", nargs=1); r.add_argument("--by", required=True)
    r.add_argument("--reason", required=True)
    r = rs.add_parser("merge"); r.add_argument("ids", nargs="+"); r.add_argument("--into", dest="by", required=True)
    r.add_argument("--reason", required=True)
    r = rs.add_parser("retire"); r.add_argument("ids", nargs="+"); r.add_argument("--reason", required=True)
    r = rs.add_parser("list"); r.add_argument("--all", action="store_true"); r.add_argument("--json", action="store_true")
    r = rs.add_parser("show"); r.add_argument("id"); r.add_argument("--lines", type=int, default=40)
    rs.add_parser("emit")
    # legacy kb aliases: `ad "<title>"` / `rg "<title>"` → recon-free mint is gone; point at the gate
    for kind in ("ad", "rg"):
        s = add(kind, lambda a, k=kind: die(f"`{k}` is now `genome rec recon <kw>` then `genome rec new {k} ...`"),
                f"(moved) use `rec new {kind}`")
        s.add_argument("title", nargs="*")

    s = add("figure", cmd_figure, "every live occurrence of a figure (propagation check)")
    s.add_argument("value")
    s = add("quarantine", cmd_quarantine, "register invalidated figures and list where to strike them")
    s.add_argument("figures", nargs="+"); s.add_argument("--why", required=True)
    s.add_argument("--where"); s.add_argument("--by")
    s = add("hyp", cmd_hyp, "hypotheses: add | verdict | list")
    s.add_argument("hyp_cmd", choices=["add", "verdict", "list"])
    s.add_argument("id", nargs="?"); s.add_argument("text", nargs="*")
    s.add_argument("--status"); s.add_argument("--evidence"); s.add_argument("--reopen")
    s.add_argument("--note"); s.add_argument("--open", action="store_true")
    s = add("prereg", cmd_prereg, "pre-registrations: freeze <spec> | check")
    s.add_argument("pr_cmd", choices=["freeze", "check"]); s.add_argument("spec", nargs="?")
    s.add_argument("--reason"); s.add_argument("--note")
    s.add_argument("--at", help="freeze the spec as committed at this ref (backfilling a pre-registration)")
    add("secrets", cmd_secrets, "scan staged+unstaged diffs for configured secret values")

    s = add("wf", cmd_wf, "workflow boards: new | add | list")
    s.add_argument("wf_cmd", choices=["new", "add", "list"]); s.add_argument("name", nargs="?")
    s.add_argument("item", nargs="?")
    s = add("claim", cmd_claim, "claim a board item")
    s.add_argument("item"); s.add_argument("--agent")
    s = add("done", cmd_done, "move a board item")
    s.add_argument("item"); s.add_argument("new_status", choices=STATUS_VOCAB)
    s.add_argument("--evidence"); s.add_argument("--note"); s.add_argument("--agent")
    s = add("claim-register", cmd_claim_register, "claim a register row")
    s.add_argument("id"); s.add_argument("--agent")
    s = add("post", cmd_post, "post to the agent feed")
    s.add_argument("message"); s.add_argument("--wf", dest="workflow"); s.add_argument("--to")
    s.add_argument("--reply"); s.add_argument("--agent")
    s = add("feed", cmd_feed, "read the feed (your mentions)")
    s.add_argument("--wf", dest="workflow"); s.add_argument("--to"); s.add_argument("--since")

    apply_overrides(Path.cwd().resolve())
    args = p.parse_args()
    if args.cmd == "hyp" and args.hyp_cmd == "verdict":
        args.status = args.status or (args.text[0] if args.text else None)
    args.fn(args)


if __name__ == "__main__":
    main()
