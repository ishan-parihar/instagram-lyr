## Law

## Detection
"""


# ---------------------------------------------------------------- kinds

# A kind is a declared entity type: fields, states, transitions, typed relations. It lives in genome.toml
# ([kinds.<name>]) or genome/kinds/*.toml. Text is the source of truth: `dir` kinds keep one markdown file per
# entity, `jsonl` kinds one append-only event log. Any index is a cache (see the index module).

RESERVED_FIELDS = {"id", "kind", "state", "title"}
STORES = ("dir", "jsonl")
MUTABILITY = ("current", "amendable", "append-only", "immutable")
KIND_KEYS = {"path", "id", "store", "mutability", "fields", "states", "initial", "transitions", "evidence_on", "evidence_ref",
             "human_only", "quarantine", "relations", "description"}
REL_KEYS = {"to", "inverse", "max", "min", "required_in", "taint", "graph", "symmetric", "default"}
WHERE_RE = re.compile(r"^\s*([A-Za-z_][\w.-]*)\s*(<=|>=|!=|=|<|>|~)\s*(.*?)\s*$")


def kind_specs(cfg: Cfg) -> dict[str, dict]:
    out = {}
    for name, k in cfg.kinds.items():
        s = dict(k)
        s.setdefault("store", "dir")
        s.setdefault("mutability", "append-only" if s["store"] == "jsonl" else "current")
        s.setdefault("fields", {})
        s.setdefault("relations", {})
        s["states"] = list(s.get("states", []))
        s.setdefault("initial", s["states"][0] if s["states"] else "")
        s["name"] = name
        out[name] = s
    return out


def kind_problems(cfg: Cfg) -> list[str]:
    """E501: a kind declaration that cannot work (checked before any entity is read)."""
    out, specs = [], kind_specs(cfg)
    for n, k in specs.items():
        def bad(msg):
            out.append(f"E501 kind `{n}`: {msg}")
        if set(k) - KIND_KEYS - {"name"}:
            bad(f"unknown key(s) {sorted(set(k) - KIND_KEYS - {'name'})} (known: {', '.join(sorted(KIND_KEYS))})")
        if not isinstance(k.get("path"), str) or not k["path"]:
            bad("`path` is required")
        elif not inside(k["path"]):
            bad("`path` must be a path inside the repo (no `..`, not absolute)")
        if "{n" not in str(k.get("id", "")):
            bad("`id` needs a counter, e.g. \"EN-{n:04}\"")
        if k["store"] not in STORES:
            bad(f"store must be one of {STORES}")
        if k["mutability"] not in MUTABILITY:
            bad(f"mutability must be one of {MUTABILITY}")
        st = set(k["states"])
        if k["states"] and k["initial"] not in st:
            bad(f"initial `{k['initial']}` is not one of its states")
        for key in ("evidence_on", "human_only"):
            if set(k.get(key, [])) - st:
                bad(f"{key} names states that do not exist: {sorted(set(k[key]) - st)}")
        for a, ts in k.get("transitions", {}).items():
            if a not in st or set(ts) - st:
                bad(f"transitions mention unknown states ({a} → {ts})")
        for f, spec in k["fields"].items():
            if f in RESERVED_FIELDS or f in k["relations"]:
                bad(f"field `{f}` clashes with a reserved name or a relation")
            elif field_error(str(spec), None, ignore_missing=True) == "spec":
                bad(f"field `{f}` has an unreadable type `{spec}`")
        for s_, spec in k.get("evidence_ref", {}).items():
            rk, _, cond = str(spec).partition("?")
            f_, _, vals = cond.partition("=")
            if s_ not in k.get("evidence_on", []) and s_ != k.get("quarantine"):
                bad(f"evidence_ref names `{s_}`, which does not take evidence (list it in evidence_on)")
            elif rk not in specs:
                bad(f"evidence_ref `{s_}` names unknown kind `{rk}`")
            elif cond and (not f_ or not vals or (f_ != "state" and f_ not in specs[rk]["fields"] and not (vals == "@self" and f_ in specs[rk]["relations"]))):
                bad(f"evidence_ref `{s_}`: `{spec}` should read kind, kind?field=a|b (field may be `state`) or kind?relation=@self")
        if k.get("quarantine") and k["quarantine"] not in st:
            bad(f"quarantine state `{k['quarantine']}` is not one of its states")
        for r, rs in k["relations"].items():
            if not isinstance(rs, dict):
                bad(f"relation `{r}` must be a table, e.g. {{ to = \"kind\" }}")
                continue
            if set(rs) - REL_KEYS:
                bad(f"relation `{r}` has unknown keys {sorted(set(rs) - REL_KEYS)} (known: {', '.join(sorted(REL_KEYS))})")
            targets = [t for t in str(rs.get("to", "")).split("|") if t]
            for t in targets:
                if t != "*" and t not in specs:
                    bad(f"relation `{r}` points at unknown kind `{t}`")
            for key in ("min", "max"):
                if key in rs and not (isinstance(rs[key], int) and rs[key] >= 0):
                    bad(f"relation `{r}`: {key} must be a whole number")
            if set(rs.get("required_in", [])) - st:
                bad(f"relation `{r}`: required_in names states that do not exist: {sorted(set(rs['required_in']) - st)}")
            if rs.get("taint"):
                if not k.get("quarantine"):
                    bad(f"relation `{r}` has `taint` but the kind declares no `quarantine` state to move into")
                known = {s for t in targets for s in (specs[t]["states"] if t in specs else [])}
                if "*" not in targets and set(rs["taint"]) - known:
                    bad(f"relation `{r}`: taint names states its targets do not have: {sorted(set(rs['taint']) - known)}")
    return out


def field_error(spec: str, value, ignore_missing: bool = False) -> str | None:
    """None when the value fits the field spec; 'spec' when the spec itself is unreadable; else a message.
    Specs: text · int[:lo..hi] · enum:a|b|c · enum:lo..hi · date · bool; a trailing `!` makes the field required."""
    req = spec.endswith("!")
    base = spec.rstrip("!")
    typ, _, arg = base.partition(":")
    if typ not in ("text", "int", "enum", "date", "bool") or (typ == "enum" and not arg):
        return "spec"
    if value in (None, ""):
        return None if ignore_missing or not req else "is required"
    v = str(value)
    if typ == "int" or (typ == "enum" and re.fullmatch(r"-?\d+\.\.-?\d+", arg)):
        if not re.fullmatch(r"-?\d+", v):
            return f"`{v}` is not an integer"
        m = re.fullmatch(r"(-?\d+)\.\.(-?\d+)", arg)
        if m and not int(m.group(1)) <= int(v) <= int(m.group(2)):
            return f"{v} is outside {arg}"
    elif typ == "enum" and v not in arg.split("|"):
        return f"`{v}` is not one of {arg}"
    elif typ == "date" and not re.fullmatch(r"\d{4}-\d\d-\d\d", v):
        return f"`{v}` is not a date (YYYY-MM-DD)"
    elif typ == "bool" and v not in ("true", "false"):
        return f"`{v}` is not true/false"
    return None


def id_regex(k: dict) -> re.Pattern:
    pre, post = re.split(r"\{n[^}]*\}", k["id"], maxsplit=1)
    return re.compile(re.escape(pre) + r"(\d+)" + re.escape(post))


def kind_dir(cfg: Cfg, k: dict) -> Path:
    return cfg.root / k["path"]


def _entity(k: dict, id_: str, state: str, title: str, fields: dict, rels: dict, history: list, path: Path, line: int = 0, body: str = "") -> dict:
    return {"id": id_, "kind": k["name"], "state": state, "title": title, "fields": fields, "rels": rels,
            "history": history, "path": path, "line": line, "body": body}


def inside(rel: str) -> bool:
    """A repo-relative path that stays in the repo: not absolute, no `..`."""
    return bool(rel) and not Path(rel).is_absolute() and ".." not in Path(rel).parts


def parse_dir_entity(k: dict, p: Path) -> dict | None:
    text = read(p)
    fm = frontmatter(text)
    if "id" not in fm or fm.get("kind") != k["name"]:
        return None
    rels = {r: [x.strip() for x in fm[r].split(",") if x.strip()] for r in k["relations"] if fm.get(r)}
    fields = {f: fm[f] for f in k["fields"] if f in fm}
    hist = [ln[2:] for ln in text.partition("\n## History")[2].splitlines() if ln.startswith("- ")]
    pre = text.partition("\n## History")[0]
    m = re.match(r"---\n.*?\n---\n", pre, re.S)
    body = re.sub(r"^\s*# .*\n", "", pre[m.end():] if m else pre, count=1).strip()
    return _entity(k, fm["id"], fm.get("state", ""), fm.get("title", ""), fields, rels, hist, p, 0, body)


def fold_jsonl(k: dict, p: Path) -> tuple[dict[str, dict], list[str]]:
    ents: dict[str, dict] = {}
    bad: list[str] = []
    for n, ln in enumerate(read(p).splitlines() if p.is_file() else [], 1):
        if not ln.strip():
            continue
        try:
            ev = json.loads(ln)
            id_, op = ev["id"], ev["op"]
        except (ValueError, KeyError, TypeError):
            bad.append(f"E504 {p.name}:{n} not a JSON event with `id` and `op`")
            continue
        e = ents.get(id_)
        if op == "new":
            if e:
                bad.append(f"E504 {p.name}:{n} duplicate id {id_}")
                continue
            ents[id_] = _entity(k, id_, ev.get("state", k["initial"]), ev.get("title", ""), dict(ev.get("fields", {})),
                                {r: list(v) for r, v in ev.get("rels", {}).items()}, [f"{ev.get('ts', '')} created"], p, n, ev.get("body", ""))
        elif not e:
            bad.append(f"E505 {p.name}:{n} event `{op}` for unknown id {id_}")
        elif op == "move":
            e["history"].append(f"{ev.get('ts', '')} {e['state']} → {ev['state']}" + (f" · evidence: {ev['evidence']}" if ev.get("evidence") else "")
                                + (f" · by {ev['by']}" if ev.get("by") else ""))
            e["state"] = ev["state"]
        elif op == "set":
            e["fields"].update(ev.get("fields", {}))
        elif op in ("link", "unlink"):
            lst = e["rels"].setdefault(ev["rel"], [])
            if op == "link" and ev["to"] not in lst:
                lst.append(ev["to"])
            elif op == "unlink" and ev["to"] in lst:
                lst.remove(ev["to"])
    return ents, bad


def load_entities(cfg: Cfg) -> tuple[dict[str, dict], list[str]]:
    """Every entity of every kind, by id; plus read problems (E504 duplicate or unreadable)."""
    ents: dict[str, dict] = {}
    bad: list[str] = []
    for k in kind_specs(cfg).values():
        found: list[dict] = []
        if k["store"] == "jsonl":
            es, b = fold_jsonl(k, kind_dir(cfg, k))
            found, bad = found + list(es.values()), bad + b
        elif kind_dir(cfg, k).is_dir():
            for f in sorted(kind_dir(cfg, k).glob("*.md")):
                e = parse_dir_entity(k, f)
                if e:
                    found.append(e)
                elif f.name not in ("README.md", "INDEX.md"):
                    bad.append(f"W501 {cfg.rel(f)} is in kind `{k['name']}`'s directory but has no `id` and `kind: {k['name']}` front-matter")
        for e in found:
            if e["id"] in ents:
                bad.append(f"E504 duplicate id {e['id']} ({cfg.rel(ents[e['id']]['path'])}, {cfg.rel(e['path'])})")
            else:
                ents[e["id"]] = e
    return ents, bad


def inverse_edges(cfg: Cfg, ents: dict[str, dict]) -> dict[str, list[tuple[str, str]]]:
    """id → [(inverse relation name, source id)]: edges are stored once, forward, and read both ways."""
    specs, out = kind_specs(cfg), {}
    for e in ents.values():
        for r, tos in e["rels"].items():
            rs = specs[e["kind"]]["relations"].get(r, {})
            inv = rs.get("inverse") or (r if rs.get("symmetric") else f"~{r}")
            for t in tos:
                out.setdefault(t, []).append((inv, e["id"]))
    return out


def relation_problems(k: dict, e: dict, ents: dict[str, dict], state: str, rels: dict | None = None) -> list[tuple[str, str]]:
    """(code, message) for E511 (a required relation missing) and E510 (an edge to a target in a taint state from an
    entity not in quarantine), judging entity `e` as if it were in `state`. Lint and `move` share this, so a step
    that lint would refuse is refused on write."""
    out, rels = [], e["rels"] if rels is None else rels
    for r, rs in k["relations"].items():
        need = int(rs.get("min", 0)) or (1 if state in rs.get("required_in", []) else 0)
        if len(rels.get(r, [])) < need:
            when = f" in state `{state}`" if not rs.get("min") else ""
            out.append(("E511", f"{e['id']}.{r} needs at least {need} target(s){when}: `genome link {e['id']} {r} <id>`"))
        if rs.get("taint") and state != k.get("quarantine"):
            for t in rels.get(r, []):
                if t in ents and ents[t]["state"] in rs["taint"]:
                    out.append(("E510", f"{e['id']}.{r} → {t} which is `{ents[t]['state']}`: "
                                        f"`genome move {e['id']} {k['quarantine']} --evidence {t}`, or unlink it"))
    return out


def lint_kinds(cfg: Cfg) -> list[str]:
    """E501-E510 / W501-W502: schema-derived checks over every declared kind."""
    out = kind_problems(cfg)
    if out:
        return out
    specs = kind_specs(cfg)
    ents, bad = load_entities(cfg)
    out += bad
    for v, vs in cfg.views.items():
        if vs.get("into") and not inside(str(vs["into"]).partition("#")[0]):
            out.append(f"E501 view `{v}`: `into` must be a path inside the repo")
    for e in ents.values():
        k, where = specs[e["kind"]], f"{cfg.rel(e['path'])}" + (f":{e['line']}" if e["line"] else "")
        if not id_regex(k).fullmatch(e["id"]):
            out.append(f"E504 {where} id {e['id']} does not match `{k['id']}`")
        if k["store"] == "dir" and not e["title"]:
            out.append(f"E502 {where} {e['id']}: title is required")
        for f, spec in k["fields"].items():
            err = field_error(str(spec), e["fields"].get(f))
            if err:
                out.append(f"E502 {where} {e['id']}.{f} {err}")
        for f in set(e["fields"]) - set(k["fields"]):
            out.append(f"E502 {where} {e['id']}.{f} is not a field of kind `{k['name']}`")
        if k["states"] and e["state"] not in k["states"]:
            out.append(f"E503 {where} {e['id']}: state `{e['state']}` is not one of {k['states']}")
        out += [f"{code} {where} {msg}" for code, msg in relation_problems(k, e, ents, e["state"])]
        for r, tos in e["rels"].items():
            rs = k["relations"].get(r)
            if rs is None:
                out.append(f"E506 {where} {e['id']}: unknown relation `{r}`")
                continue
            if rs.get("max") and len(tos) > int(rs["max"]):
                out.append(f"E507 {where} {e['id']}.{r} has {len(tos)} targets, the limit is {rs['max']}")
            allowed = [t for t in str(rs.get("to", "*")).split("|") if t]
            for t in tos:
                if t not in ents:
                    out.append(f"E505 {where} {e['id']}.{r} → {t}: no such entity")
                elif "*" not in allowed and ents[t]["kind"] not in allowed:
                    out.append(f"E506 {where} {e['id']}.{r} → {t}: `{ents[t]['kind']}` is not one of {allowed}")
        for st in k.get("evidence_on", []):
            if e["state"] == st and not any(f"→ {st}" in h and "evidence:" in h for h in e["history"]):
                out.append(f"E509 {where} {e['id']} is `{st}` but its history names no evidence")
        for st in k.get("human_only", []):
            if e["state"] == st and not any(f"→ {st}" in h and "by human:" in h for h in e["history"]):
                out.append(f"W502 {where} {e['id']} is `{st}`, a human-only state, with no human sign-off in its history")
    for k in specs.values():  # frozen kinds: the laws a table of contents only asserts
        path = kind_dir(cfg, k)
        if not path.exists() or not is_git(cfg):
            continue
        if k["mutability"] == "append-only" and k["store"] == "jsonl":
            log = sh(cfg.root, "git", "log", "--numstat", "--format=%h", "--", k["path"])
            commit = None
            for ln in log.splitlines():
                m = re.fullmatch(r"(\d+)\t(\d+)\t.*", ln)
                if not m:
                    commit = ln
                elif int(m.group(2)):
                    out.append(f"E508 {k['path']}: commit {commit} removed lines from an append-only log")
        elif k["mutability"] == "immutable" and k["store"] == "dir":
            for f in sorted(path.glob("*.md")):
                n = len(sh(cfg.root, "git", "log", "--format=%h", "--", cfg.rel(f)).split())
                if n > 1:
                    out.append(f"E508 {cfg.rel(f)} is immutable but was changed in {n} commits")
    return out


# ---- commands

def next_entity_id(k: dict, ents: dict[str, dict], counters: dict | None = None) -> str:
    """The next free id. A batch passes `counters` so the scan over every id happens once per kind, not once per entity."""
    if counters is not None and k["name"] in counters:
        n = counters[k["name"]] + 1
    else:
        rx = id_regex(k)
        n = max([int(m.group(1)) for i in ents for m in [rx.fullmatch(i)] if m], default=0) + 1
    if counters is not None:
        counters[k["name"]] = n
    return k["id"].format(n=n)


def parse_sets(pairs: list[str] | None) -> dict[str, str]:
    out = {}
    for p in pairs or []:
        k, sep, v = p.partition("=")
        if not sep:
            die(f"--set expects key=value, got `{p}`")
        out[k.strip()] = v.strip()
    return out


def entity_text(k: dict, e: dict, body: str = "") -> str:
    fm = {"id": e["id"], "kind": k["name"], "state": e["state"], "title": e["title"], **e["fields"],
          **{r: ", ".join(v) for r, v in e["rels"].items() if v}}
    head = "".join(f'{key}: "{yq(v)}"\n' for key, v in fm.items())
    hist = "".join(f"- {h}\n" for h in e["history"])
    return f"---\n{head}---\n\n# {e['title']}\n\n" + (body + "\n\n" if body else "") + f"## History\n\n{hist}"


def write_entity(cfg: Cfg, k: dict, e: dict) -> None:
    """Persist one entity: a dir kind rewrites its file (front-matter + history); a jsonl kind never calls this."""
    p = e["path"]
    old = read(p) if p.exists() else ""
    if old:
        fields = {"state": e["state"], **e["fields"], **{r: ", ".join(v) for r, v in e["rels"].items()}}
        text = set_front(old, {key: val for key, val in fields.items()})
        text = text.rstrip("\n") + "\n"
        marker = "## History"
        head = text.split(marker)[0].rstrip("\n") + "\n\n" if marker in text else text.rstrip("\n") + "\n\n"
        text = head + marker + "\n\n" + "".join(f"- {h}\n" for h in e["history"])
        atomic_write(p, text)
    else:
        atomic_write(p, entity_text(k, e))


def append_event(path: Path, ev: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "a") as f:
        f.write(json.dumps({"ts": now(), **ev}, ensure_ascii=False) + "\n")


def kind_of(cfg: Cfg, name: str) -> dict:
    specs = kind_specs(cfg)
    if name not in specs:
        die(f"no kind `{name}` — declared kinds: {', '.join(specs) or '(none)'}; declare one under [kinds.{name}] in genome.toml")
    probs = [p for p in kind_problems(cfg)]
    if probs:
        die("\n".join(probs))
    return specs[name]


def entity_of(cfg: Cfg, id_: str) -> tuple[dict, dict, dict[str, dict]]:
    ents, _ = load_entities(cfg)
    if id_ not in ents:
        die(f"no entity `{id_}`")
    return ents[id_], kind_specs(cfg)[ents[id_]["kind"]], ents


def human_check(k: dict, state: str, args) -> str:
    who = f"human:{args.human}" if args.human else args.agent or os.environ.get("GENOME_AGENT_ID", "agent")
    if state in k.get("human_only", []) and not args.human:
        die(f"`{state}` is human-only for kind `{k['name']}`: the operator runs `genome move <id> {state} --human <name>`", ERR)
    return who


def parse_links(pairs) -> dict[str, list[str]]:
    """`rel=ID` pairs (repeatable; `rel=A,B` for several), or a JSON object {rel: id | [ids]}."""
    out: dict[str, list[str]] = {}
    items = pairs.items() if isinstance(pairs, dict) else [p.partition("=")[::2] for p in pairs or []]
    for r, v in items:
        r = r.strip()
        if not r or not v:
            die(f"--link expects relation=ID, got `{r}={v}`")
        for t in (v if isinstance(v, list) else str(v).split(",")):
            if "=" in str(t):
                die(f"--link {r}={v}: `=` inside a value. Repeat the flag for each relation: --link {r}=A --link {str(t).partition('=')[0]}=B")
            if str(t).strip() and str(t).strip() not in out.setdefault(r, []):
                out[r].append(str(t).strip())
    return out


def draft_entity(cfg: Cfg, k: dict, ents: dict[str, dict], title: str, sets: dict, links: dict[str, list[str]], who: str, counters: dict | None = None, id_: str | None = None) -> dict:
    """Validate one new entity against its kind (fields, relation targets, cardinality, defaults) and give it an id.
    Raises SystemExit with the reason; writes nothing."""
    for f in sets:
        if f not in k["fields"]:
            die(f"`{f}` is not a field of `{k['name']}` (fields: {', '.join(k['fields']) or 'none'})")
    for f, spec in k["fields"].items():
        err = field_error(str(spec), sets.get(f))
        if err:
            die(f"{k['name']}.{f} {err}")
    if k["store"] == "dir" and not title:
        die(f"a title is required for `{k['name']}` (a directory kind)")
    for r, rs in k["relations"].items():
        if r not in links and rs.get("default"):
            links[r] = [rs["default"]]
    for r, tos in links.items():
        rs = k["relations"].get(r)
        if rs is None:
            die(f"`{k['name']}` has no relation `{r}` (relations: {', '.join(k['relations']) or 'none'})")
        allowed = [t for t in str(rs.get("to", "*")).split("|") if t]
        for t in tos:
            if t not in ents:
                die(f"{k['name']}.{r} → {t}: no such entity")
            if "*" not in allowed and ents[t]["kind"] not in allowed:
                die(f"{r} points at {allowed}, but {t} is `{ents[t]['kind']}`", ERR)
        if rs.get("max") and len(tos) > int(rs["max"]):
            die(f"{r} allows at most {rs['max']} target(s), got {len(tos)}", ERR)
    missing = [r for r, rs in k["relations"].items() if int(rs.get("min", 0)) > len(links.get(r, []))
               or (k["initial"] in rs.get("required_in", []) and not links.get(r))]
    if missing:
        die(f"`{k['name']}` needs " + ", ".join(f"--link {r}=<id>" + (f"×{k['relations'][r]['min']}" if int(k['relations'][r].get('min', 0)) > 1 else "")
                                              for r in missing), ERR)
    tainted = [m.split(": `genome")[0] for c, m in relation_problems(k, {"id": f"new {k['name']}"}, ents, k["initial"], links) if c == "E510"]
    if tainted:
        die("a new entity must not depend on a tainted target (quarantine state): " + "; ".join(tainted), ERR)
    id_ = id_ or next_entity_id(k, ents, counters)
    path = kind_dir(cfg, k) if k["store"] == "jsonl" else kind_dir(cfg, k) / f"{id_}-{slugify(title, 50)}.md"
    return _entity(k, id_, k["initial"], title or "", dict(sets), links,
                   [f"{now()} created · state {k['initial']} · by {who}"], path)


def persist_new(cfg: Cfg, k: dict, e: dict, body: str, who: str) -> None:
    if k["store"] == "jsonl":
        append_event(e["path"], {"id": e["id"], "op": "new", "state": e["state"], "title": e["title"], "fields": e["fields"],
                                 **({"rels": e["rels"]} if e["rels"] else {}), **({"body": body} if body else {}), "by": who})
    else:
        atomic_write(e["path"], entity_text(k, e, body))


def batch_lines(src: str, kind: str | None) -> list[dict]:
    text = sys.stdin.read() if src == "-" else read(Path(src)) if Path(src).is_file() else die(f"no batch file `{src}`")
    out = []
    for n, ln in enumerate(text.splitlines(), 1):
        if not ln.strip():
            continue
        try:
            d = json.loads(ln)
        except ValueError as ex:
            die(f"batch line {n}: not JSON ({ex})")
        if not isinstance(d, dict) or not (d.get("kind") or kind):
            die(f"batch line {n}: needs an object with `kind` (or pass the kind as the argument)")
        out.append({"n": n, "kind": d.get("kind") or kind, "title": d.get("title", ""), "set": d.get("set", {}),
                    "link": d.get("link", {}), "body": d.get("body", "")})
    return out


def cmd_new(args) -> None:
    """One entity (`new <kind> --title T --set k=v --link rel=ID`), or many from `--batch FILE|-` (JSON lines of
    {kind, title, set, link, body}; `@N` in a link names the entity made by batch line N). A batch is validated whole
    before anything is written: one bad line writes nothing."""
    cfg = find_cfg()
    who = args.agent or os.environ.get("GENOME_AGENT_ID", "agent")
    if args.batch:
        items = batch_lines(args.batch, args.kind)
    elif not args.kind:
        die("new needs a kind (or --batch FILE)")
    else:
        items = [{"n": 0, "kind": args.kind, "title": args.title or "", "set": parse_sets(args.set),
                  "link": args.link, "body": args.body or ""}]
    with Guarded(cfg.root / ".genome" / "entities"):
        ents, _ = load_entities(cfg)
        made, by_line, counters = [], {}, {}
        global DIE_PREFIX
        if args.batch:  # every line gets its id first, so `@N` may name a later line and a loop can close inside one batch
            for it in items:
                DIE_PREFIX = f"batch line {it['n']}: "
                k = kind_of(cfg, it["kind"])
                by_line[str(it["n"])] = i_ = next_entity_id(k, ents, counters)
                ents[i_] = _entity(k, i_, k["initial"], it["title"], {}, {}, [], None)  # a placeholder until its line is drafted
        for it in items:
            DIE_PREFIX = f"batch line {it['n']}: " if it["n"] else ""
            k = kind_of(cfg, it["kind"])
            links = parse_links(it["link"])
            own = by_line.get(str(it["n"]))
            if it["n"]:
                links = {r: [by_line.get(t[1:], t) if t.startswith("@") else t for t in tos] for r, tos in links.items()}
                bad = [t for tos in links.values() for t in tos if t.startswith("@")]
                if bad:
                    die(f"{bad[0]} names no line of this batch (lines are numbered from 1 over the input)")
                if own in [t for tos in links.values() for t in tos]:
                    die("a line cannot link to itself")
            sets = {f: str(v).lower() if isinstance(v, bool) else str(v) for f, v in it["set"].items()}
            e = draft_entity(cfg, k, ents, it["title"], sets, links, who, counters, id_=own)
            ents[e["id"]] = e
            made.append((k, e, it["body"]))
        DIE_PREFIX = ""
        for k, e, body in made:
            persist_new(cfg, k, e, body, who)
    if args.json:
        res = [{"id": e["id"], "kind": k["name"], "state": e["state"]} for k, e, _ in made]
        jprint(res if args.batch else res[0])
    else:
        for k, e, _ in made:
            print(f"{e['id']} created ({k['name']}{', ' + e['state'] if e['state'] else ''})")


def evidence_ref_problem(k: dict, state: str, ev: str, ents: dict[str, dict], me: str = "") -> str:
    """Why `ev` is not the kind of evidence this kind's `evidence_ref` demands for `state`, or "" when it is."""
    spec = k.get("evidence_ref", {}).get(state)
    if not spec:
        return ""
    rk, _, cond = str(spec).partition("?")
    f, _, vals = cond.partition("=")
    t = ents.get(ev)
    if t is None or t["kind"] != rk:
        return f"evidence for `{state}` must be the id of a `{rk}` entity" + (f" with {f}={vals}" if f else "")
    if vals == "@self":  # the evidence must itself point at the entity being moved (a red-team of *this* thesis)
        return "" if me in t["rels"].get(f, []) else f"evidence {ev} must have `{f}` pointing at {me}"
    have = t["state"] if f == "state" else t["fields"].get(f, "")
    if f and have not in vals.split("|"):
        return f"evidence {ev} has {f}={have or '(unset)'}; `{state}` needs {f}={vals}"
    return ""


def evidence_ok(cfg: Cfg, ev: str, ents: dict[str, dict]) -> bool:
    return ev.startswith(("commit:", "http://", "https://")) or (cfg.root / ev).exists() or ev in ents


def cmd_move(args) -> None:
    """move <id>[,<id>…] <state>: every id is checked before any is moved."""
    cfg = find_cfg()
    specs, (ents, _) = kind_specs(cfg), load_entities(cfg)
    plan = []
    for id_ in [i for i in args.id.split(",") if i]:
        if id_ not in ents:
            die(f"no entity `{id_}`")
        e = ents[id_]
        k = specs[e["kind"]]
        if k["states"] and args.state not in k["states"]:
            die(f"`{args.state}` is not a state of `{k['name']}` ({', '.join(k['states'])})")
        allowed = k.get("transitions", {})
        exit_ = args.state == k.get("quarantine")  # quarantine is reachable from anywhere, with the tainting id as evidence
        if allowed and not exit_ and args.state not in allowed.get(e["state"], []):
            die(f"{e['id']}: {e['state']} → {args.state} is not allowed; from `{e['state']}` you may go to {allowed.get(e['state'], []) or 'nowhere (terminal)'}", ERR)
        if args.state in k.get("evidence_on", []) or exit_:
            if not args.evidence:
                die(f"{e['id']} → {args.state} needs --evidence <existing path | entity id | commit:<sha> | URL>")
            if not evidence_ok(cfg, args.evidence, ents):
                die(f"evidence is not an existing path, entity id, commit:<sha> or URL: {args.evidence}")
            why = evidence_ref_problem(k, args.state, args.evidence, ents, e["id"])
            if why:
                die(f"{e['id']} → {args.state} is refused: {why}", ERR)
        probs = relation_problems(k, e, ents, args.state)
        if probs:
            die(f"{e['id']} → {args.state} is refused: " + "; ".join(m for _, m in probs), ERR)
        plan.append((e, k, human_check(k, args.state, args)))
    for e, k, who in plan:
        entry = f"{now()} {e['state']} → {args.state}" + (f" · evidence: {args.evidence}" if args.evidence else "") + f" · by {who}"
        with Guarded(e["path"]):
            if k["store"] == "jsonl":
                append_event(e["path"], {"id": e["id"], "op": "move", "state": args.state, "evidence": args.evidence or "", "by": who})
            else:
                cur = parse_dir_entity(k, e["path"])
                cur["state"], cur["history"] = args.state, cur["history"] + [entry]
                write_entity(cfg, k, cur)
        print(f"{e['id']}: → {args.state}")


def cmd_link(args, undo: bool = False) -> None:
    """link <a> <relation> <b>[,<b>…]: every target is checked before any edge is written."""
    cfg = find_cfg()
    e, k, ents = entity_of(cfg, args.a)
    rs = k["relations"].get(args.rel)
    if rs is None:
        die(f"`{k['name']}` has no relation `{args.rel}` (relations: {', '.join(k['relations']) or 'none'})")
    targets = list(dict.fromkeys(t for t in args.b.split(",") if t))
    missing = [t for t in targets if t not in ents]
    if missing:
        die(f"no entity `{missing[0]}`")
    allowed = [t for t in str(rs.get("to", "*")).split("|") if t]
    cur, changed = list(e["rels"].get(args.rel, [])), []
    for b in targets:
        if not undo and "*" not in allowed and ents[b]["kind"] not in allowed:
            die(f"{args.rel} points at {allowed}, but {b} is `{ents[b]['kind']}`", ERR)
        if not undo and rs.get("symmetric") and args.a in ents[b]["rels"].get(args.rel, []):
            print(f"{args.a} {args.rel} {b} already holds ({b} → {args.a}; `{args.rel}` is symmetric)")
        elif undo and b in cur:
            cur.remove(b)
            changed.append(b)
        elif not undo and b not in cur:
            if rs.get("max") and len(cur) >= int(rs["max"]):
                die(f"{args.rel} allows at most {rs['max']} target(s) and {args.a} has {len(cur)}", ERR)
            cur.append(b)
            changed.append(b)
    probs = relation_problems(k, e, ents, e["state"], {**e["rels"], args.rel: cur})
    if undo:
        gone = [m for c, m in probs if c == "E511" and f"{args.a}.{args.rel} " in m]
        if gone:
            die("cannot unlink: " + "; ".join(gone), ERR)
    else:
        tainted = [m.split(": `genome")[0] for c, m in probs if c == "E510" and any(f"→ {b} " in m for b in changed)]
        if tainted:
            die("cannot link: " + "; ".join(tainted) + f" (a tainted target is linked only from a `{k.get('quarantine')}` entity)", ERR)
    for b in changed:
        add_edge(cfg, k, e, args.rel, b, undo)
        print(f"{args.a} {args.rel} {'-/→' if undo else '→'} {b}")


def add_edge(cfg: Cfg, k: dict, e: dict, rel: str, to: str, undo: bool = False) -> None:
    with Guarded(e["path"]):
        if k["store"] == "jsonl":
            append_event(e["path"], {"id": e["id"], "op": "unlink" if undo else "link", "rel": rel, "to": to})
        else:
            cur = parse_dir_entity(k, e["path"])
            lst = cur["rels"].setdefault(rel, [])
            if undo and to in lst:
                lst.remove(to)
            elif not undo and to not in lst:
                lst.append(to)
            write_entity(cfg, k, cur)


def cmd_set(args) -> None:
    """set <id> --set field=value …: typed field updates, recorded in History (dir) or as a `set` event (jsonl)."""
    cfg = find_cfg()
    e, k, _ = entity_of(cfg, args.id)
    if k["mutability"] == "immutable":
        die(f"`{k['name']}` is immutable: supersede {e['id']} with a new entity instead", ERR)
    sets = parse_sets(args.set)
    if not sets:
        die("set needs at least one --set field=value")
    for f, v in sets.items():
        if f not in k["fields"]:
            die(f"`{f}` is not a field of `{k['name']}` (fields: {', '.join(k['fields']) or 'none'})")
        err = field_error(str(k["fields"][f]), v)
        if err:
            die(f"{f} {err}")
    who = args.agent or os.environ.get("GENOME_AGENT_ID", "agent")
    with Guarded(e["path"]):
        if k["store"] == "jsonl":
            append_event(e["path"], {"id": e["id"], "op": "set", "fields": sets, "by": who})
        else:
            cur = parse_dir_entity(k, e["path"])
            cur["fields"].update(sets)
            cur["history"].append(f"{now()} set {', '.join(sets)} · by {who}")
            write_entity(cfg, k, cur)
    print(f"{e['id']}: set {', '.join(f'{f}={v}' for f, v in sets.items())}")


def cmd_show(args) -> None:
    """show <id>[,<id>…]: one call reads several entities (fields, relations both ways, recent history)."""
    cfg = find_cfg()
    ents, _ = load_entities(cfg)
    invs = inverse_edges(cfg, ents)
    ids = [i for i in args.id.split(",") if i]
    missing = [i for i in ids if i not in ents]
    if missing:
        die(f"no entity `{missing[0]}`" + (f" (and {len(missing) - 1} more)" if len(missing) > 1 else ""))
    docs = []
    for id_ in ids:
        e, inv = ents[id_], invs.get(id_, [])
        if args.json:
            docs.append({"id": e["id"], "kind": e["kind"], "state": e["state"], "title": e["title"], "fields": e["fields"],
                         "relations": e["rels"], "inverse": [{"rel": r, "from": s} for r, s in inv], "history": e["history"],
                         **({"body": e["body"]} if e["body"] else {}), "path": cfg.rel(e["path"])})
            continue
        if docs:
            print()
        docs.append(e)
        print(f"{e['id']}  {e['kind']}  [{e['state']}]  {e['title']}")
        for f, v in e["fields"].items():
            print(f"  {f}: {v}")
        for r, tos in e["rels"].items():
            print(f"  {r} → {', '.join(f'{t} ({ents[t]['title'] or ents[t]['kind']})' if t in ents else t + ' (missing)' for t in tos)}")
        for r, sid in inv:
            print(f"  {r} ← {sid} ({ents[sid]['title'] or ents[sid]['kind']})")
        if e["body"]:
            lines = e["body"].splitlines()
            print("  | " + "\n  | ".join(lines[:30]) + (f"\n  | … {len(lines) - 30} more line(s) in the file" if len(lines) > 30 else ""))
        for h in e["history"][-5:]:
            print(f"  · {h}")
        print(f"  {cfg.rel(e['path'])}" + (f":{e['line']}" if e["line"] else ""))
    if args.json:
        jprint(docs[0] if len(docs) == 1 else docs)


def entity_value(e: dict, key: str) -> str:
    return {"id": e["id"], "kind": e["kind"], "state": e["state"], "title": e["title"]}.get(key, e["fields"].get(key, ""))


def matches(e: dict, conds: list[str]) -> bool:
    for c in conds or []:
        m = WHERE_RE.match(c)
        if not m:
            die(f"cannot read the condition `{c}` — use `field op value` with op one of = != < > <= >= ~")
        key, op, want = m.groups()
        have = entity_value(e, key)
        if op == "~":
            ok = want.lower() in have.lower()
        else:
            try:
                a, b = float(have), float(want)
            except ValueError:
                a, b = have, want
            ok = {"=": a == b, "!=": a != b, "<": a < b, ">": a > b, "<=": a <= b, ">=": a >= b}[op] if have != "" or op == "!=" else False
        if not ok:
            return False
    return True


def find_entities(cfg: Cfg, kind: str | None, conds: list[str], state: str | None = None) -> list[dict]:
    ents, _ = load_entities(cfg)
    return [e for e in ents.values() if (not kind or e["kind"] == kind) and (not state or e["state"] == state) and matches(e, conds)]


def cmd_find(args) -> None:
    cfg = find_cfg()
    kind_of(cfg, args.kind)
    hits = find_entities(cfg, args.kind, args.where, args.state)[:args.limit]
    if args.json:
        jprint([{"id": e["id"], "state": e["state"], "title": e["title"], "fields": e["fields"]} for e in hits])
        return
    for e in hits:
        extra = " ".join(f"{f}={v}" for f, v in e["fields"].items())[:70]
        print(f"{e['id']:12} {e['state']:12} {e['title'][:50]:50} {extra}")
    print(f"{len(hits)} {args.kind}")


def view_hits(cfg: Cfg, v: dict) -> list[dict]:
    hits = find_entities(cfg, v.get("kind"), v.get("where", []), v.get("state"))
    sort = v.get("sort", "id")
    hits.sort(key=lambda e: entity_value(e, sort.lstrip("-")), reverse=sort.startswith("-"))
    return hits


def wake_views(cfg: Cfg) -> list[str]:
    """`wake = true` views: a blueprint's work queue, 5 rows each, so orientation needs no further call."""
    out, empty = [], []
    for name, v in cfg.views.items():
        if v.get("wake") and not v.get("group_count"):
            hits = view_hits(cfg, v)
            if hits:
                out.append(f"- {name}: {len(hits)}")
                out += [f"    {e['id']} [{e['state']}] {e['title'][:70]}" for e in hits[:5]]
            else:
                empty.append(name)
    return out + ([f"- empty: {', '.join(empty)}"] if empty else [])


def render_view(cfg: Cfg, v: dict) -> str:
    hits = view_hits(cfg, v)
    cols = v.get("columns", ["id", "state", "title"])
    if v.get("group_count"):  # a generated count per state: numbers are never hand-written
        counts: dict[str, int] = {}
        for e in hits:
            counts[e["state"]] = counts.get(e["state"], 0) + 1
        return "| state | count |\n|---|---|\n" + "".join(f"| {s} | {n} |\n" for s, n in counts.items()) + f"| **total** | {len(hits)} |\n"
    body = "| " + " | ".join(cols) + " |\n|" + "---|" * len(cols) + "\n"
    for e in hits[:int(v.get("limit", 200))]:
        body += "| " + " | ".join(entity_value(e, c).replace("|", "\\|") for c in cols) + " |\n"
    return body


def emit_views(cfg: Cfg) -> list[str]:
    changed = []
    for name, v in cfg.views.items():
        target = v.get("into")
        if not target:
            continue
        if not inside(str(target).partition("#")[0]):
            die(f"view `{name}`: into = `{target}` leaves the repo")
        path, _, zone = target.partition("#")
        if write_zone(cfg.root / path, zone or name, render_view(cfg, v)) and path not in changed:
            changed.append(path)
    return changed


def cmd_view(args) -> None:
    cfg = find_cfg()
    if args.name not in cfg.views:
        die(f"no view `{args.name}` — declared: {', '.join(cfg.views) or '(none)'}; declare [views.{args.name}] in genome.toml")
    print(render_view(cfg, cfg.views[args.name]), end="")
# ---------------------------------------------------------------- index and graph

# `.genome/index.db` is a cache: sections (FTS5, BM25), entities and typed edges, rebuilt incrementally from content
# hashes. Delete it and the next command rebuilds it identically. Nothing here is a source of truth.

INDEX_VERSION = 1


def index_path(cfg: Cfg) -> Path:
    return cfg.root / ".genome" / "index.db"


def open_index(cfg: Cfg):
    import sqlite3
    p = index_path(cfg)
    p.parent.mkdir(exist_ok=True)
    con = sqlite3.connect(p)
    if con.execute("pragma user_version").fetchone()[0] != INDEX_VERSION:
        for t in ("docs", "sec", "ent", "ent_fts", "edges"):
            con.execute(f"drop table if exists {t}")
        con.execute(f"pragma user_version = {INDEX_VERSION}")
    con.executescript("""
        create table if not exists docs(path text primary key, sha text, kind text);
        create virtual table if not exists sec using fts5(path unindexed, heading, body, a unindexed, b unindexed,
                                                           tokenize='porter unicode61');
        create table if not exists ent(id text primary key, kind text, state text, title text, path text);
        create virtual table if not exists ent_fts using fts5(id unindexed, kind unindexed, title, body, tokenize='porter unicode61');
        create table if not exists edges(src text, rel text, dst text, path text);
        create table if not exists vec(sid integer primary key, v text);
        create index if not exists edges_src on edges(src);
        create index if not exists edges_dst on edges(dst);
    """)
    return con


def file_sha(p: Path) -> str:
    return hashlib.sha1(p.read_bytes()).hexdigest()


def refresh_index(cfg: Cfg, con) -> dict:
    """Bring the cache in line with the working tree. Only changed files are re-read."""
    stats = {"sections": 0, "entities": 0, "removed": 0, "embedded": 0}
    have = dict(con.execute("select path, sha from docs"))
    live: dict[str, tuple[Path, str]] = {}
    for f in corpus(cfg):
        live[cfg.rel(f)] = (f, "doc")
    specs = kind_specs(cfg)
    for k in specs.values():
        d = kind_dir(cfg, k)
        for f in ([d] if k["store"] == "jsonl" and d.is_file() else sorted(d.glob("*.md")) if d.is_dir() else []):
            live[cfg.rel(f)] = (f, f"kind:{k['name']}")
    for rel in set(have) - set(live):
        drop_doc(con, rel)
        stats["removed"] += 1
    for rel, (f, kind) in live.items():
        sha = file_sha(f)
        if have.get(rel) == sha:
            continue
        drop_doc(con, rel)
        if kind == "doc":
            for h, a, b, body in chunks(f):
                con.execute("insert into sec(path, heading, body, a, b) values (?,?,?,?,?)", (rel, h, body, a, b))
                stats["sections"] += 1
        else:
            k = specs[kind.split(":", 1)[1]]
            es = list(fold_jsonl(k, f)[0].values()) if k["store"] == "jsonl" else [e for e in [parse_dir_entity(k, f)] if e]
            for e in es:
                body = " ".join([e["title"], *map(str, e["fields"].values())]) + " " + (read(f) if k["store"] == "dir" else e["body"])
                con.execute("insert or replace into ent values (?,?,?,?,?)", (e["id"], e["kind"], e["state"], e["title"], rel))
                con.execute("insert into ent_fts(id, kind, title, body) values (?,?,?,?)", (e["id"], e["kind"], e["title"], body))
                for r, tos in e["rels"].items():
                    con.executemany("insert into edges values (?,?,?,?)", [(e["id"], r, t, rel) for t in tos])
                stats["entities"] += 1
        con.execute("insert or replace into docs values (?,?,?)", (rel, sha, kind))
    if cfg.get("index", "embed"):  # embed every section that has no vector yet (new, changed, or the hook was just set)
        todo = con.execute("select sec.rowid, sec.body from sec left join vec on vec.sid = sec.rowid "
                           "where vec.sid is null").fetchall()
        for sid, vec in embed_texts(cfg, [(str(s), b) for s, b in todo]).items():
            con.execute("insert into vec(sid, v) values (?, ?)", (int(sid), json.dumps([round(x, 5) for x in vec])))
            stats["embedded"] += 1
    con.commit()
    return stats


def drop_doc(con, rel: str) -> None:
    con.execute("delete from vec where sid in (select rowid from sec where path = ?)", (rel,))
    con.execute("delete from sec where path = ?", (rel,))
    ids = [r[0] for r in con.execute("select id from ent where path = ?", (rel,))]
    for i in ids:
        con.execute("delete from ent_fts where id = ?", (i,))
    con.execute("delete from ent where path = ?", (rel,))
    con.execute("delete from edges where path = ?", (rel,))
    con.execute("delete from docs where path = ?", (rel,))


def fts_query(text: str) -> str:
    words = [w for w in re.findall(r"[A-Za-z0-9]+", text) if w.lower() not in STOP and (len(w) > 2 or w.isupper() or w.isdigit())]
    return " OR ".join(f'"{w}"' for w in dict.fromkeys(words))


def embed_texts(cfg: Cfg, items: list[tuple[str, str]]) -> dict[str, list[float]]:
    """The optional `[index] embed` hook: a command that reads JSON lines {"id","text"} on stdin and answers JSON lines
    {"id","vec"} on stdout, one per input. The kernel stays stdlib-only; without the hook the index is lexical."""
    cmd = cfg.get("index", "embed", "")
    if not cmd or not items:
        return {}
    inp = "".join(json.dumps({"id": i, "text": t}) + "\n" for i, t in items)
    r = subprocess.run(cmd, shell=True, cwd=cfg.root, input=inp, capture_output=True, text=True)
    if r.returncode != 0:
        die(f"[index] embed hook failed ({r.returncode}): {r.stderr.strip()[:300]}", ERR)
    out = {}
    for line in r.stdout.splitlines():
        if line.strip():
            o = json.loads(line)
            out[o["id"]] = o["vec"]
    if any(i not in out for i, _ in items):
        die(f"[index] embed hook returned no vector for {sum(i not in out for i, _ in items)} input(s)", ERR)
    return out


def cosine(a: list[float], b: list[float]) -> float:
    na, nb = math.sqrt(sum(x * x for x in a)), math.sqrt(sum(x * x for x in b))
    return sum(x * y for x, y in zip(a, b)) / (na * nb) if na and nb else 0.0


def index_ask(cfg: Cfg, question: str, k: int = 6) -> tuple[list[tuple[float, Path, str, int, int, str]], list[dict]]:
    """BM25 over sections (heading weighted 3x) plus the nearest entities. With an embed hook, the BM25 pool is
    re-ranked by cosine. Same tuple shape as `ask_rank`."""
    con = open_index(cfg)
    refresh_index(cfg, con)
    q = fts_query(question)
    if not q:
        return [], []
    rows = con.execute("select rowid, bm25(sec, 0.0, 3.0, 1.0), path, heading, a, b, body from sec where sec match ? "
                       "order by 2 limit ?", (q, max(k * 8, 40) if cfg.get("index", "embed") else k)).fetchall()
    hits = [(-s, cfg.root / p, h, int(a), int(b), body) for _, s, p, h, a, b, body in rows]
    if cfg.get("index", "embed") and rows:
        qv = embed_texts(cfg, [("q", question)])["q"]
        vecs = dict(con.execute(f"select sid, v from vec where sid in ({','.join('?' * len(rows))})",
                                [r[0] for r in rows]).fetchall())
        ranked = sorted(((cosine(qv, json.loads(vecs[r[0]])), h) for r, h in zip(rows, hits) if r[0] in vecs),
                        key=lambda t: -t[0])
        hits = [(round(c, 4), *h[1:]) for c, h in ranked[:k]]
    ents = [{"id": i, "kind": kd, "title": t, "score": round(-s, 1)} for s, i, kd, t in con.execute(
        "select bm25(ent_fts, 0.0, 0.0, 4.0, 1.0), id, kind, title from ent_fts where ent_fts match ? order by 1 limit ?", (q, k))]
    return hits, ents


# ---- graph (undirected unless noted; edges are stored forward once)

def load_graph(cfg: Cfg) -> tuple[dict[str, dict], dict[str, set[str]], dict[str, set[str]], list[tuple[str, str, str]]]:
    """(entity info by id, undirected adjacency, directed adjacency, edges) from the index."""
    con = open_index(cfg)
    refresh_index(cfg, con)
    info = {i: {"kind": k, "state": s, "title": t} for i, k, s, t in con.execute("select id, kind, state, title from ent")}
    specs = kind_specs(cfg)

    def rel(s: str, r: str) -> dict:
        return specs.get(info[s]["kind"], {}).get("relations", {}).get(r, {})
    # a quarantined entity (retracted, tainted: not its initial state) is not relied on, so it bridges nothing
    dead = {i for i, v in info.items() if (k := specs.get(v["kind"], {})).get("quarantine")
            and v["state"] == k["quarantine"] and v["state"] != k.get("initial")}
    # `graph = false` edges (membership, provenance) are stored and linted but are not topology
    edges = [(s, r, d) for s, r, d in con.execute("select src, rel, dst from edges")
             if s in info and d in info and s not in dead and d not in dead and rel(s, r).get("graph", True) is not False]
    und: dict[str, set[str]] = {i: set() for i in info}
    out: dict[str, set[str]] = {i: set() for i in info}
    for s, r, d in edges:
        und[s].add(d); und[d].add(s)
        if not rel(s, r).get("symmetric"):  # a symmetric relation has no direction, so it cannot close a loop
            out[s].add(d)
    return info, und, out, edges


def project(info: dict[str, dict], und: dict[str, set[str]], out: dict[str, set[str]], kind: str):
    """The graph seen from one kind: two K nodes are adjacent when linked directly or through one non-K node
    (concept — claim — concept). The usual input to ABC discovery."""
    keep = {i for i in info if info[i]["kind"] == kind}

    def hop(adj, a):
        near = {b for b in adj[a] if b in keep}
        near |= {b for m in adj[a] if m not in keep for b in adj[m] if b in keep}
        return near - {a}
    return ({i: info[i] for i in keep}, {a: hop(und, a) for a in keep}, {a: hop(out, a) for a in keep})


def namespaces(cfg: Cfg, info: dict[str, dict], across: str) -> dict[str, str]:
    """Each node's namespace: the first target of relation `across` (a node that is such a target is its own
    namespace), else the value of field `across`. Nodes with neither have none and never count as crossing."""
    specs = kind_specs(cfg)
    if any(across in k["relations"] for k in specs.values()):
        ns: dict[str, str] = {}
        for s, d in open_index(cfg).execute("select src, dst from edges where rel = ? order by rowid", (across,)):
            ns.setdefault(s, d)
            ns.setdefault(d, d)
        return ns
    if not any(across in k["fields"] for k in specs.values()):
        die(f"--across `{across}` is neither a relation nor a field of any kind")
    ents, _ = load_entities(cfg)
    return {i: e["fields"][across] for i, e in ents.items() if i in info and e["fields"].get(across)}


def bfs_path(adj: dict[str, set[str]], a: str, b: str) -> list[str] | None:
    prev, queue = {a: None}, [a]
    for n in queue:
        if n == b:
            path = []
            while n is not None:
                path.append(n); n = prev[n]
            return path[::-1]
        for m in sorted(adj.get(n, ())):
            if m not in prev:
                prev[m] = n; queue.append(m)
    return None


def betweenness(adj: dict[str, set[str]]) -> dict[str, float]:
    """Brandes. Exact up to a few thousand nodes; callers cap the node count."""
    bc = {v: 0.0 for v in adj}
    for s in adj:
        stack, pred, sigma, dist, q = [], {v: [] for v in adj}, dict.fromkeys(adj, 0), dict.fromkeys(adj, -1), [s]
        sigma[s], dist[s] = 1, 0
        for v in q:
            stack.append(v)
            for w in adj[v]:
                if dist[w] < 0:
                    dist[w] = dist[v] + 1; q.append(w)
                if dist[w] == dist[v] + 1:
                    sigma[w] += sigma[v]; pred[w].append(v)
        delta = dict.fromkeys(adj, 0.0)
        for w in reversed(stack):
            for v in pred[w]:
                delta[v] += sigma[v] / sigma[w] * (1 + delta[w])
            if w != s:
                bc[w] += delta[w]
    return {v: b / 2 for v, b in bc.items()}


def find_bridges(adj: dict[str, set[str]]) -> list[tuple[str, str]]:
    """Edges whose removal disconnects their component (iterative Tarjan low-link)."""
    disc, low, out, t = {}, {}, [], 0
    for root in adj:
        if root in disc:
            continue
        disc[root] = low[root] = t = t + 1
        stack = [(root, None, iter(sorted(adj[root])))]
        while stack:
            v, parent, it = stack[-1]
            for w in it:
                if w == parent:
                    continue
                if w in disc:
                    low[v] = min(low[v], disc[w])
                else:
                    disc[w] = low[w] = t = t + 1
                    stack.append((w, v, iter(sorted(adj[w]))))
                    break
            else:
                stack.pop()
                if stack:
                    u = stack[-1][0]
                    low[u] = min(low[u], low[v])
                    if low[v] > disc[u]:
                        out.append((u, v))
    return out


def find_cycles(out: dict[str, set[str]]) -> list[list[str]]:
    """Strongly connected components of size > 1 (and self-loops) in the directed graph: knots that feed themselves."""
    index, low, on, stack, res, counter = {}, {}, set(), [], [], [0]

    def strong(v):
        work = [(v, iter(sorted(out[v])))]
        index[v] = low[v] = counter[0]; counter[0] += 1; stack.append(v); on.add(v)
        while work:
            u, it = work[-1]
            for w in it:
                if w not in index:
                    index[w] = low[w] = counter[0]; counter[0] += 1; stack.append(w); on.add(w)
                    work.append((w, iter(sorted(out[w]))))
                    break
                elif w in on:
                    low[u] = min(low[u], index[w])
            else:
                work.pop()
                if work:
                    low[work[-1][0]] = min(low[work[-1][0]], low[u])
                if low[u] == index[u]:
                    comp = []
                    while True:
                        w = stack.pop(); on.discard(w); comp.append(w)
                        if w == u:
                            break
                    if len(comp) > 1 or u in out[u]:
                        res.append(sorted(comp))

    for v in sorted(out):
        if v not in index:
            strong(v)
    return res


def open_triads(und: dict[str, set[str]], limit: int, keep=None) -> list[tuple[str, str, list[str]]]:
    """Pairs (A, C) with no edge between them that share neighbours B: the unseen connection worth testing (ABC discovery)."""
    shared: dict[tuple[str, str], list[str]] = {}
    for b, ns in und.items():
        ns = sorted(ns)
        for i, a in enumerate(ns):
            for c in ns[i + 1:]:
                if c not in und[a] and (keep is None or keep(a, c)):
                    shared.setdefault((a, c), []).append(b)
    ranked = sorted(shared.items(), key=lambda kv: (-len(kv[1]), kv[0]))
    return [(a, c, bs) for (a, c), bs in ranked[:limit]]


def label(info: dict[str, dict], i: str) -> str:
    return f"{i} {info[i]['title'][:50]}".rstrip() if i in info else i


def cmd_graph(args) -> None:
    cfg = find_cfg()
    if not cfg.kinds:
        die("no kinds declared — graph queries run over typed entities (see [kinds.*] in genome.toml)")
    info, und, out, edges = load_graph(cfg)
    if args.kind:
        if args.kind not in kind_specs(cfg):
            die(f"no kind `{args.kind}`")
        info, und, out = project(info, und, out, args.kind)
    ns = namespaces(cfg, info, args.across) if args.across else {}

    def crosses(a: str, b: str) -> bool:
        return not args.across or (a in ns and b in ns and ns[a] != ns[b])
    q = args.query
    res: object
    if q in ("neighbors", "path"):
        if args.a not in info:
            die(f"no entity `{args.a}`" + (f" of kind `{args.kind}`" if args.kind else ""))
    if q == "neighbors":
        seen, frontier, layers = {args.a}, [args.a], []
        for _ in range(args.depth):
            nxt = sorted({m for n in frontier for m in und[n]} - seen)
            seen |= set(nxt); frontier = nxt
            layers.append(nxt)
        res = {"id": args.a, "layers": layers}
        text = [f"depth {d + 1}: " + ", ".join(label(info, i) for i in ly) for d, ly in enumerate(layers) if ly] or ["(isolated)"]
    elif q == "path":
        if not args.b or args.b not in info:
            die("path needs two entity ids: graph path <a> <b>")
        p = bfs_path(und, args.a, args.b)
        res, text = {"path": p}, [" → ".join(label(info, i) for i in p) if p else "no path"]
    elif q == "hubs":
        bc = betweenness(und) if len(und) <= 3000 else dict.fromkeys(und, 0.0)
        cross = {i: sum(1 for m in und[i] if crosses(i, m)) for i in und}
        pool = [i for i in und if cross[i]] if args.across else [i for i in und if und[i]]  # a node with no edges is no hub
        rows = sorted(pool, key=lambda i: (-cross[i], -len(und[i]), -bc[i], i) if args.across else (-len(und[i]), -bc[i], i))[:args.top]
        res = [{"id": i, "degree": len(und[i]), "betweenness": round(bc[i], 1), **({"across": cross[i]} if args.across else {})} for i in rows]
        text = [(f"across {cross[i]:3} " if args.across else "") + f"deg {len(und[i]):3} btw {bc[i]:7.1f}  {label(info, i)}" for i in rows]
    elif q == "cycles":
        cs = [c for c in find_cycles(out) if not args.across or len({ns.get(i) for i in c} - {None}) > 1]
        res, text = cs, [" ⟲ ".join(c) for c in cs] or ["no cycles"]
    elif q == "bridges":
        bs = [(a, b) for a, b in find_bridges(und) if crosses(a, b)]
        res, text = bs, [f"{label(info, a)} — {label(info, b)}" for a, b in bs] or ["no bridges"]
    elif q == "gaps":
        tr = open_triads(und, args.top, crosses if args.across else None)
        res = [{"a": a, "c": c, "via": bs} for a, c, bs in tr]
        text = [f"{label(info, a)}  ?—?  {label(info, c)}   via {', '.join(bs[:4])}" for a, c, bs in tr] or ["no open triads"]
    else:
        die("graph query: neighbors | path | hubs | cycles | bridges | gaps")
    if args.json:
        jprint(res)
    else:
        print("\n".join(text))


def cmd_place(args) -> None:
    """Where does this text land: candidate kinds, nearest entities, proposed edges. Nothing is written."""
    cfg = find_cfg()
    text = " ".join(args.text)
    con = open_index(cfg)
    refresh_index(cfg, con)
    q = fts_query(text)
    near = [(round(-s, 1), i, kd, st, t) for s, i, kd, st, t in con.execute(
        "select bm25(ent_fts, 0.0, 0.0, 4.0, 1.0), ent_fts.id, ent_fts.kind, ent.state, ent_fts.title from ent_fts "
        "join ent on ent.id = ent_fts.id where ent_fts match ? order by 1 limit ?", (q, args.k))] if q else []
    secs = [(cfg.rel(p), a, h) for _, p, h, a, _, _ in index_ask(cfg, text, 2)[0]] if q else []
    kinds: dict[str, float] = {}
    for s, _, kd, _, _ in near:
        kinds[kd] = kinds.get(kd, 0) + s
    specs = kind_specs(cfg)
    ranked = sorted(kinds, key=lambda x: -kinds[x])
    # proposed edges: for each declared kind, relations whose allowed targets include a nearby entity's kind
    props = []
    for name, k in specs.items():
        for r, rs in k["relations"].items():
            allowed = [t for t in str(rs.get("to", "*")).split("|") if t]
            for s, i, kd, _, t in near[:5]:
                if "*" in allowed or kd in allowed:
                    props.append({"if_new_kind": name, "relation": r, "target": i, "target_title": t})
    out = {"candidate_kinds": ranked or list(specs), "nearest": [{"id": i, "kind": kd, "state": st, "title": t, "score": s}
                                                                   for s, i, kd, st, t in near],
           "sections": [{"path": p, "line": a, "heading": h} for p, a, h in secs],
           "proposed_edges": [p for p in props if not ranked or p["if_new_kind"] == ranked[0]][:8]}
    if args.json:
        jprint(out)
        return
    print("candidate kinds: " + ", ".join(out["candidate_kinds"]))
    for n in out["nearest"]:
        print(f"  near {n['score']:6.1f}  {n['id']} [{n['state']}] {n['title'][:60]}")
    for s in out["sections"]:
        print(f"  doc  {s['path']}:{s['line']}  § {s['heading'][:60]}")
    by_target: dict[tuple, list[str]] = {}
    for p in out["proposed_edges"]:  # one line per nearby entity, the candidate relations joined
        by_target.setdefault((p["if_new_kind"], p["target"], p["target_title"]), []).append(p["relation"])
    for (kd, tid, ttl), rels in by_target.items():
        print(f"  edge: new {kd} → {tid} ({ttl[:40]}) via {' | '.join(rels)}")
    print("then: `genome new <kind> …` and `genome link <new> <relation> <target>`")


def cmd_index(args) -> None:
    cfg = find_cfg()
    if args.rebuild:
        index_path(cfg).unlink(missing_ok=True)
    con = open_index(cfg)
    st = refresh_index(cfg, con)
    n = {t: con.execute(f"select count(*) from {t}").fetchone()[0] for t in ("docs", "sec", "ent", "edges")}
    print(f"index: {n['docs']} files · {n['sec']} sections · {n['ent']} entities · {n['edges']} edges "
          f"(this run: +{st['sections']} sections, +{st['entities']} entities, -{st['removed']} files"
          + (f", {st['embedded']} embedded" if st["embedded"] else "") + f") — {cfg.rel(index_path(cfg))}")


def cmd_impact(args) -> None:
    """What would moving <id> into a taint state flag? Follows the cascade one hop at a time: a pointer that lint would
    flag is assumed quarantined before the next hop, which is how the cascade runs in life. Reads only; writes nothing."""
    cfg = find_cfg()
    specs, (ents, _) = kind_specs(cfg), load_entities(cfg)
    if args.id not in ents:
        die(f"no entity `{args.id}`")
    root_kind = ents[args.id]["kind"]
    pointing = [(k, r, rs) for k in specs.values() for r, rs in k["relations"].items()
                if rs.get("taint") and (root_kind in str(rs.get("to", "")).split("|") or "*" in str(rs.get("to", "")))]
    state = args.to
    if not state:
        options = sorted({s for _, _, rs in pointing for s in rs["taint"] if s in specs[root_kind]["states"]})
        if len(options) != 1:
            die(f"`{root_kind}` can be tainted into {options or 'no state'}; say which: `genome impact {args.id} --to <state>`")
        state = options[0]
    elif specs[root_kind]["states"] and state not in specs[root_kind]["states"]:
        die(f"`{state}` is not a state of `{root_kind}` ({', '.join(specs[root_kind]['states'])})")
    hops, seen, frontier = [], {args.id}, [(args.id, state)]
    while frontier:
        found: dict[tuple[str, str], list[str]] = {}  # (state to move into, tainting id) → pointers
        nxt = []
        for tid, st in frontier:
            for e in ents.values():
                k = specs[e["kind"]]
                if e["id"] in seen or e["state"] == k.get("quarantine"):
                    continue
                if any(tid in e["rels"].get(r, []) and st in rs.get("taint", []) for r, rs in k["relations"].items()):
                    seen.add(e["id"])
                    found.setdefault((k.get("quarantine") or "(no quarantine state: unlink it)", tid), []).append(e["id"])
                    if k.get("quarantine"):
                        nxt.append((e["id"], k["quarantine"]))
        if not found:
            break
        hops.append(found)
        frontier = nxt
    if args.json:
        jprint({"id": args.id, "to": state, "hops": [[{"move_to": s, "evidence": t, "ids": ids} for (s, t), ids in h.items()] for h in hops]})
        return
    n = sum(len(i) for h in hops for i in h.values())
    print(f"impact of {args.id} → {state}: " + (f"{n} entit{'y' if n == 1 else 'ies'} flagged over {len(hops)} hop(s); nothing is changed by this command" if n else "nothing depends on it"))
    for i, h in enumerate(hops, 1):
        print(f"hop {i}" + ("" if i == 1 else f" (after hop {i - 1} is quarantined)"))
        for (s, t), ids in h.items():
            print(f"  {','.join(ids)}  →  genome move {','.join(ids)} {s} --evidence {t}" if s[0] != "(" else f"  {','.join(ids)}  {s}")
# ---------------------------------------------------------------- federation, drift, upgrade

# Each repo keeps its own genome. A card is one small JSON summary of it, written to a cache outside the repo;
# the meta root reads cards instead of walking repos. Nothing here writes into a peer repo.

CARD_SCHEMA = 1
CARD_CLASSES = ("intent", "architecture", "operate", "decisions", "status")
CARD_BUDGET = 24_000  # bytes: a card must fit a session's context
SECRET_SHAPES = re.compile(r"Bearer\s+[A-Za-z0-9._~+/=-]{20,}|\b(?:sk|pk|ghp|gho|glpat|xox[bap])[-_][A-Za-z0-9_-]{16,}|"
                           r"-----BEGIN [A-Z ]*PRIVATE KEY-----|\bAKIA[0-9A-Z]{16}\b")


def cards_dir(cfg: Cfg | None = None) -> Path:
    v = os.environ.get("GENOME_CARDS") or (cfg.get("federation", "cache") if cfg else None) or "~/.cache/genome/cards"
    return Path(v).expanduser()


ROLE_FORMS = ("overlay:", "native:")

CLASS_ROLES = {
    "intent": "readme",
    "operate": "runbook",
    "decisions": "records_index",
    "status": "state",
}
# a class with no role of its own falls back to the agent contract, which every repo has:
# the intent is what it says it is, the architecture is how it says it is built
CLASS_FALLBACK = {"intent": ("agents", ""), "architecture": ("agents", "Architecture")}


def role_form_path(cfg: Cfg, raw: str) -> str:
    """The file a role form names, when it names one this repo actually has.

    A role may be written as `overlay:<path>` or `native:<path>` to say the answer
    lives outside the distributed tree, or `native:<prose>` when the answer is a
    description rather than a file. Only the file form resolves to a doc; a prose
    form resolves to nothing, and the class stays empty because there is no
    document to point at.
    """
    for prefix in ROLE_FORMS:
        if not raw.startswith(prefix):
            continue
        tail = raw[len(prefix):].split(" ", 1)[0].strip()
        if tail and (cfg.root / tail).exists():
            return tail
        return ""
    return raw


def card_class_path(cfg: Cfg, cls: str) -> str:
    """Where a doc class lives: [card] override, else the role that answers it."""
    v = cfg.get("card", cls)
    if v:
        return v
    role = CLASS_ROLES.get(cls)
    if role and role in cfg.paths:
        raw = cfg.paths[role]
        if raw.startswith(ROLE_FORMS):        # a role form names a doc this repo may hold
            return role_form_path(cfg, raw)
        if (cfg.root / raw.split("#", 1)[0]).exists():
            return raw
    fb = CLASS_FALLBACK.get(cls)
    if fb and fb[0] in cfg.paths:
        raw = cfg.paths[fb[0]]
        if not raw.startswith(ROLE_FORMS) and (cfg.root / raw.split("#", 1)[0]).exists():
            return f"{raw}#{fb[1]}" if fb[1] else raw
    return ""


def head_sha(cfg: Cfg, short: bool = True) -> str:
    return sh(cfg.root, "git", "rev-parse", *(["--short"] if short else []), "HEAD").strip()


def purpose_of(cfg: Cfg) -> str:
    if cfg.get("card", "purpose"):
        return cfg.get("card", "purpose")
    for role, heading in (("agents", "What this project is"), ("readme", "")):
        if not cfg.has(role):
            continue
        text = read(cfg.path(role))
        if heading and heading.lower() in text.lower():
            text = text[text.lower().index(heading.lower()):].partition("\n")[2]
        for para in re.split(r"\n\s*\n", text):
            para = " ".join(para.split())
            if len(para) > 40 and not para.startswith(("#", "|", "```", "<", "---", "![", "[!")):
                return para[:300]
    return ""


def manual_docs(cfg: Cfg) -> list[tuple[Path, list[str], str]]:
    """(doc, covers, verified) for every doc that declares `covers` in its front-matter."""
    pats = cfg.get("drift", "paths", ["**/README.md", "**/AGENTS.md", "docs/**/*.md"])
    out = []
    for rel in sorted(x for x in tracked(cfg) if x.endswith(".md") and any(gmatch(x, g, cfg) for g in pats)):
        f = cfg.root / rel
        fm = frontmatter(read(f)[:4000])
        if fm.get("covers"):
            out.append((f, [c.strip().strip('"\'') for c in re.split(r"[,\[\]]", fm["covers"]) if c.strip().strip('"\'')], fm.get("verified", "")))
    return out


def stale_files(cfg: Cfg, covers: list[str], verified: str) -> list[str] | None:
    """Paths under `covers` changed between `verified` and HEAD; None when the sha is unknown to git."""
    if not sh(cfg.root, "git", "cat-file", "-t", verified).strip().startswith("commit"):
        return None
    return sh(cfg.root, "git", "diff", "--name-only", f"{verified}..HEAD", "--", *[f":(glob){c}" for c in covers]).split()


def lint_drift(cfg: Cfg) -> list[str]:
    """W401/E401 a manual's covered code changed since it was verified · W402 no verified sha · W403 sha unknown · W404 covers matches nothing."""
    if not is_git(cfg):
        return []
    sev = "E" if cfg.get("drift", "mode", "warn") == "error" else "W"
    until = cfg.get("drift", "warn_until", "")  # nested plan decision 4: after the window, a repo with a gate blocks close
    if sev == "W" and until and cfg.get("core", "gate") and dt.date.today().isoformat() > str(until):
        sev = "E"
    out, files = [], tracked(cfg)
    for f, covers, verified in manual_docs(cfg):
        rel = cfg.rel(f)
        if not any(gmatch(x, c, cfg) for c in covers for x in files):
            out.append(f"W404 {rel} covers {covers}, which match no tracked file (a typo, or the code moved)")
            continue
        if not verified:
            out.append(f"W402 {rel} declares covers but no `verified` sha — after reviewing it, run `genome verify {rel} --reviewed`")
            continue
        changed = stale_files(cfg, covers, verified)
        if changed is None:
            out.append(f"W403 {rel}: verified sha {verified} is not in this repository's history")
        elif changed:
            out.append(f"{sev}401 {rel} is stale: {len(changed)} covered path(s) changed since {verified} "
                       f"({', '.join(changed[:3])}{' …' if len(changed) > 3 else ''}) — review, then `genome verify {rel} --reviewed`")
    return out


def cmd_verify(args) -> None:
    """Record that a person or agent has compared this manual with the code it covers, at the current HEAD."""
    cfg = find_cfg()
    if not args.reviewed:
        die("verify records that you read the manual against its covered code: pass --reviewed once you have")
    p = (cfg.root / args.doc) if not Path(args.doc).is_absolute() else Path(args.doc)
    if not p.is_file():
        die(f"{args.doc} is not a file")
    fm = frontmatter(read(p))
    if not fm.get("covers") and not args.covers:
        die(f"{args.doc} has no `covers` front-matter: pass --covers 'glob, glob' to declare what it describes")
    sha = args.sha or head_sha(cfg)
    if not sha:
        die("verify records a commit: commit the manual and the code it covers first, then verify")
    fields = {"verified": sha}
    if args.covers:
        fields["covers"] = args.covers
    atomic_write(p, set_front(read(p), fields))
    print(f"{cfg.rel(p)}: verified {sha}")


def register_summary(cfg: Cfg) -> tuple[dict[str, int], list[dict]]:
    rs = register_rows(cfg) if cfg.has("register") else None
    counts: dict[str, int] = {}
    openr = []
    for r in rs or []:
        if len(r) > 2 and r[1] in STATUS_VOCAB:
            counts[r[1]] = counts.get(r[1], 0) + 1
            if r[1] in ("open", "in-progress", "blocked"):
                openr.append({"id": r[0], "status": r[1], "item": r[2][:100]})
    return counts, openr


def build_card(cfg: Cfg) -> dict:
    """The card: built from the working tree, never from git history; read-only."""
    privacy = cfg.get("card", "privacy", "internal")
    classes = {}
    for c in CARD_CLASSES:
        v = card_class_path(cfg, c)
        classes[c] = {"path": v, "exists": bool(v) and (cfg.root / v.split("#")[0]).exists()}
    heads = {}
    for c, d in classes.items():
        f = cfg.root / d["path"].split("#")[0] if d["exists"] else None
        if f and f.is_file() and f.suffix == ".md":
            heads[c] = [(h[:70], a) for h, a, b, _ in sections(f) if h != f.name][:25]
    routing = [[r[0][:90], r[1][:90]] for r in rows(cfg.path("agents")) if len(r) > 1][:40] if cfg.has("agents") else []
    counts, openr = register_summary(cfg)
    lint = run_lint(cfg)
    errs = sum(1 for x in lint if x.startswith("E"))
    kinds = {}
    if cfg.kinds and privacy != "local":
        ents, _ = load_entities(cfg)
        for e in ents.values():
            kinds.setdefault(e["kind"], {}).setdefault(e["state"], 0)
            kinds[e["kind"]][e["state"]] += 1
    manuals = []
    for f, covers, verified in manual_docs(cfg):
        ch = stale_files(cfg, covers, verified) if verified and is_git(cfg) else None
        manuals.append({"path": cfg.rel(f), "covers": covers, "verified": verified, "stale": bool(ch)})
    comps = [{"name": Path(c).name, "path": c} for g in cfg.get("card", "components", []) for c in
             sorted(cfg.rel(p) for p in cfg.root.glob(g) if p.is_dir())][:60]
    card = {"schema": CARD_SCHEMA, "name": cfg.root.name, "root": str(cfg.root), "genome": VERSION, "head": head_sha(cfg),
            "built": now(), "privacy": privacy, "purpose": purpose_of(cfg), "modules": sorted(cfg.modules),
            "classes": classes, "headings": heads, "routing": routing, "components": comps,
            "register": {"counts": counts, "open": openr[:30]}, "kinds": kinds, "manuals": manuals,
            "records": [{"id": r["id"], "title": r["title"][:80]} for r in (records(cfg)[:50] if "records" in cfg.modules else [])],
            "health": {"errors": errs, "warnings": len(lint) - errs}}
    return card


def card_problems(card: dict, cfg: Cfg) -> list[str]:
    text = json.dumps(card, ensure_ascii=False)
    out = [f"secret-shaped string in the card ({m.group(0)[:12]}…)" for m in SECRET_SHAPES.finditer(text)][:3]
    out += [f"a configured secret value from {spec} appears in the card" for spec, v in secret_values(cfg) if v in text]
    if len(text.encode()) > CARD_BUDGET:
        out.append(f"card is {len(text.encode())} bytes, over the {CARD_BUDGET} budget — trim [card] components or the register")
    return out


def write_card(cfg: Cfg, to: Path | None = None) -> tuple[Path | None, list[str]]:
    if cfg.get("card", "privacy") == "local":
        return None, ["privacy = local: this genome publishes no card"]
    card = build_card(cfg)
    probs = card_problems(card, cfg)
    if probs:
        return None, probs
    d = to or cards_dir(cfg)
    d.mkdir(parents=True, exist_ok=True)
    out = d / f"{slugify(card['name'], 80)}.json"
    atomic_write(out, json.dumps(card, ensure_ascii=False, indent=1) + "\n")
    return out, []


def cmd_card(args) -> None:
    cfg = find_cfg()
    if args.stdout:
        jprint(build_card(cfg))
        return
    out, probs = write_card(cfg, Path(args.out).expanduser() if args.out else None)
    if probs:
        die("card not written: " + "; ".join(probs), ERR)
    print(f"card: {out} ({out.stat().st_size} bytes)")


def federation_repos(cfg: Cfg) -> list[Path]:
    """The federation's members: every directory the globs reach that holds a genome,
    minus the ones the operator excludes by name.

    Membership would otherwise be an accident of how deep a directory sits: a glob
    that reaches one level too deep also reaches a fixture. `[federation] exclude`
    names the directories to skip, so membership is a decision.
    """
    seen = []
    skip = set(cfg.get("federation", "exclude", []))
    for g in cfg.get("federation", "repos", ["*", "*/*"]):
        for d in sorted(cfg.root.glob(g)):
            if d.is_dir() and d != cfg.root and (d / "genome.toml").is_file() and d not in seen \
                    and not any(x in d.relative_to(cfg.root).parts for x in HEAVY_DIRS | skip):
                seen.append(d)
    return seen


def cmd_federate(args) -> None:
    """Build every member's card into the cache (reading each tree, writing none) and refresh the portfolio zone."""
    cfg = find_cfg()
    cache = cards_dir(cfg)
    rows_, skipped = [], []
    here = Path.cwd()
    for d in federation_repos(cfg):
        try:
            os.chdir(d)
            sub = find_cfg(d)
            out, probs = write_card(sub, cache)
        except SystemExit:
            skipped.append(f"{d.name}: unreadable genome")
            continue
        finally:
            os.chdir(here)
        if probs:
            skipped.append(f"{d.name}: {'; '.join(probs)}")
            continue
        c = json.loads(out.read_text())
        rows_.append(c)
    into = cfg.get("federation", "status_into")
    if into and rows_:
        body = "| repo | genome | lint | open items | purpose |\n|---|---|---|---|---|\n"
        for c in sorted((c for c in rows_ if c["privacy"] != "private"), key=lambda c: c["name"]):  # private repos stay in the cache
            h = c["health"]
            body += (f"| {c['name']} | {c['genome']} | {h['errors']}E {h['warnings']}W | {len(c['register']['open'])} | "
                     f"{c['purpose'][:90].replace('|', '/')} |\n")
        path, _, zone = into.partition("#")
        write_zone(cfg.root / path, zone or "portfolio", body)
    print(f"federate: {len(rows_)} card(s) in {cache}" + (f"; skipped {len(skipped)}" if skipped else ""))
    for s in skipped:
        print(f"  skipped {s}")


def load_cards(cfg: Cfg | None = None) -> list[dict]:
    d = cards_dir(cfg)
    return [json.loads(p.read_text()) for p in sorted(d.glob("*.json"))] if d.is_dir() else []


def cards_ask(question: str, k: int, cfg: Cfg | None = None) -> list[dict]:
    """Repos ranked by how many question terms their card covers (idf across repos, field-weighted), each with the
    best-matching item as the pointer. Coverage beats repetition: a term found ten times counts once."""
    q = toks(question)
    cards = [c for c in load_cards(cfg) if c.get("privacy") != "local"]
    items: dict[str, list[tuple[float, set[str], str, str, str]]] = {}
    for c in cards:
        it = [(3.0, toks(c["purpose"]), "purpose", "", c["purpose"]), (4.0, toks(c["name"].replace("-", " ")), "name", "", c["name"])]  # own name outranks a mention in another purpose
        it += [(2.5, toks(f"{a} {b}"), "operate" if "run" in b.lower() else "routing", b, a) for a, b in c["routing"]]
        for cls, hs in c["headings"].items():
            it += [(1.5, toks(h), cls, f"{c['classes'][cls]['path'].split('#')[0]}:{ln}", h) for h, ln in hs]
        it += [(1.0, toks(r["item"]), "register", r["id"], r["item"]) for r in c["register"]["open"]]
        it += [(1.0, toks(r["title"]), "decisions", r["id"], r["title"]) for r in c["records"]]
        items[c["name"]] = it
    df = {t: sum(any(t in x[1] for x in it) for it in items.values()) for t in q}
    n = max(len(cards), 1)
    hits = []
    for c in cards:
        it = items[c["name"]]
        score = sum(math.log(1 + n / (1 + df[t])) * max((w for w, ts, *_ in it if t in ts), default=0) for t in q)
        if score <= 0:
            continue
        w, ts, cls, where, text = max(it, key=lambda x: (len(q & x[1]), x[0]))
        hits.append({"score": round(score, 1), "repo": c["name"], "pointer": f"repo:{c['name']}#{cls if cls not in ('name',) else 'intent'}",
                     "where": where, "match": text[:100], "head": c["head"], "built": c["built"]})
    return sorted(hits, key=lambda h: -h["score"])[:k]


def cmd_resolve(args) -> None:
    """repo:<name>#<class> → the file in that repo (from its card)."""
    m = re.fullmatch(r"repo:([\w.-]+)#(\w+)", args.pointer)
    if not m:
        die("a repo pointer looks like repo:<name>#<class>, e.g. repo:operant#architecture")
    name, cls = m.groups()
    try:
        cfg = find_cfg()
    except SystemExit:  # outside any genome: the default cache still answers
        cfg = None
    cards = {c["name"]: c for c in load_cards(cfg)}
    if name not in cards:
        die(f"no card for `{name}` in {cards_dir(cfg)} — run `genome federate` at the meta root (or `genome card` in that repo)")
    c = cards[name]
    if cls not in c["classes"] or not c["classes"][cls]["path"]:
        die(f"{name} declares no `{cls}` document (classes: {', '.join(k for k, v in c['classes'].items() if v['path'])})")
    path = c["classes"][cls]["path"].split("#")[0]
    print(f"{Path(c['root']) / path}" + ("" if c["classes"][cls]["exists"] else "  (missing)") + f"  [card {c['built']} @ {c['head']}]")


def emit_status(cfg: Cfg) -> list[str]:
    """Generated status zone (counts from the register, never hand-kept) in the doc named by [card] status_into."""
    into = cfg.get("card", "status_into")
    if not into or not cfg.has("register"):
        return []
    counts, openr = register_summary(cfg)
    body = "| status | items |\n|---|---|\n" + "".join(f"| {s} | {counts[s]} |\n" for s in STATUS_VOCAB if s in counts)
    body += "\n" + "".join(f"- `{r['id']}` [{r['status']}] {r['item']}\n" for r in openr[:10]) if openr else ""
    path, _, zone = into.partition("#")
    return [path] if write_zone(cfg.root / path, zone or "status", body) else []


# ---- upgrade

SCHEMA_VERSION = 2
MIGRATIONS: dict[int, object] = {}  # target schema_version → fn(text) that rewrites genome.toml in place


def migrate_v2(text: str) -> str:
    """Schema 2 has one glob dialect. A slashless membership pattern matched at any depth under schema 1, so it
    gets the `**/` prefix that keeps that meaning; every other line is left as written."""
    for k in RETIRED_PATHS:
        text = re.sub(rf'^{k}\s*=[^\n]*\n', "", text, count=1, flags=re.M)
    for s, k, p in membership_problems(tomllib.loads(text)):
        text = re.sub(rf'^({re.escape(k)}\s*=\s*\[[^\]]*?)"{re.escape(p)}"',
                      lambda m: m.group(1) + f'"**/{p}"', text, count=1, flags=re.M)
    tomllib.loads(text)  # the result must still be valid TOML
    return text


MIGRATIONS[2] = migrate_v2


def apply_overrides(start: Path) -> None:
    """`.genome/overrides/<NAME>.md` replaces the built-in template text NAME (RECORDS_TPL, AGENTS_TPL, …): local
    template edits live beside the repo's config instead of in a hand-patched copy of this file."""
    for d in [start, *start.parents]:
        o = d / ".genome" / "overrides"
        if o.is_dir():
            for f in o.glob("*.md"):
                if f.stem in globals() and f.stem.endswith("_TPL") and isinstance(globals()[f.stem], str):
                    globals()[f.stem] = f.read_text()
            return
        if (d / "genome.toml").exists() or (d / "kb.toml").exists():
            return


def skill_copy() -> Path:
    return Path(os.environ.get("GENOME_SKILL", "~/.agents/skills/project-genome/scripts/genome")).expanduser()


def file_version(text: str) -> str:
    m = re.search(r'^VERSION = "([^"]+)"', text, re.M)
    return m.group(1) if m else "?"


def cmd_upgrade(args) -> None:
    """Compare this repo's vendored CLI with the skill's copy; --apply swaps it in, keeping a backup and any local patch as a diff."""
    import difflib
    cfg = find_cfg()
    new = skill_copy()
    me = Path(__file__).resolve()
    if not new.is_file():
        die(f"no skill copy at {new} (set GENOME_SKILL)")
    mine_t, new_t = me.read_text(), new.read_text()
    if mine_t == new_t:
        print(f"genome {VERSION}: up to date")
        return
    rel = cfg.rel(me)
    print(f"{rel}: {file_version(mine_t)} → {file_version(new_t)}")
    releases = {}
    rf = new.with_name("releases.txt")
    if rf.is_file():
        releases = {ln.split()[0]: ln.split()[1] for ln in rf.read_text().splitlines() if len(ln.split()) >= 2 and not ln.startswith("#")}
    known = releases.get(VERSION)
    sha = hashlib.sha256(me.read_bytes()).hexdigest()
    patched = known is not None and not sha.startswith(known)
    if known is None:
        print(f"note: no recorded checksum for {VERSION}; cannot tell whether this copy was hand-patched")
    if patched:
        print("this copy differs from the released one: it carries a local patch. Moving a template change into "
              "`.genome/overrides/<TEMPLATE>.md` keeps it across upgrades; other edits belong in the skill.")
    if not args.apply:
        diff = list(difflib.unified_diff(mine_t.splitlines(), new_t.splitlines(), lineterm="", n=0))
        print(f"{sum(1 for d in diff if d.startswith('+') and not d.startswith('+++'))} lines added, "
              f"{sum(1 for d in diff if d.startswith('-') and not d.startswith('---'))} removed. `genome upgrade --apply` swaps it in.")
        return
    if patched and not args.accept_patch_loss:
        die("refusing: this copy has local edits that the swap would drop. Re-run with --accept-patch-loss to keep the diff "
            "at .genome/local-patch.diff and continue", ERR)
    bak = cfg.root / ".genome"
    bak.mkdir(exist_ok=True)
    (bak / "genome.pre-upgrade").write_text(mine_t)
    if patched:
        (bak / "local-patch.diff").write_text("\n".join(difflib.unified_diff(mine_t.splitlines(), new_t.splitlines(), "vendored", "skill", lineterm="")))
    atomic_write(me, new_t)
    me.chmod(0o755)
    print(f"upgraded {rel} to {file_version(new_t)} (backup: .genome/genome.pre-upgrade)")
    subprocess.run([sys.executable, str(me), "migrate"], cwd=cfg.root)  # the new code runs its own config migrations


def cmd_migrate(args) -> None:
    """Bring genome.toml to this CLI's schema_version (each migration is a function of the config text)."""
    cfg = find_cfg()
    f = cfg.root / ("kb.toml" if cfg.legacy else "genome.toml")
    text = f.read_text()
    cur = cfg.schema_version
    if cur > SCHEMA_VERSION:
        die(f"genome.toml is schema_version {cur}; this CLI knows up to {SCHEMA_VERSION} — upgrade the CLI", ERR)
    for v in range(cur + 1, SCHEMA_VERSION + 1):
        if v in MIGRATIONS:
            text = MIGRATIONS[v](text)
    if re.search(r"^schema_version\s*=", text, re.M):
        text = re.sub(r"^schema_version\s*=.*$", f"schema_version = {SCHEMA_VERSION}", text, count=1, flags=re.M)
    elif re.search(r"^\[genome\]\s*$", text, re.M):
        text = re.sub(r"^(\[genome\][^\n]*\n)", rf"\1schema_version = {SCHEMA_VERSION}\n", text, count=1, flags=re.M)
    else:
        text = f"[genome]\nschema_version = {SCHEMA_VERSION}\n\n" + text
    if text != f.read_text():
        atomic_write(f, text)
        print(f"{f.name}: schema_version {cur} → {SCHEMA_VERSION}")
    else:
        print(f"{f.name}: schema_version {SCHEMA_VERSION} (nothing to migrate)")
# ---------------------------------------------------------------- blueprints

BP_KEYS = {"name", "version", "summary", "extends", "modules", "privacy", "routes", "playbook", "seed"}
PRIVACY = ("local", "private", "internal")  # strictest first


def bp_load(spec: str, root: Path | None = None, near: Path | None = None) -> tuple[dict, str, str]:
    """(parsed, toml text, origin) for a blueprint: a path, then genome/blueprints/<n>.toml, a sibling of the file
    that extends it, the built-in set, or a profile name (modules only)."""
    cand = None
    if spec.endswith(".toml") or "/" in spec:
        cand = Path(spec).expanduser()
        if not cand.is_file():
            die(f"no blueprint file `{spec}`")
    else:
        cand = next((d / f"{spec}.toml" for d in (root and root / "genome" / "blueprints", near)
                     if d and (d / f"{spec}.toml").is_file()), None)
    if cand:
        text, origin = read(cand), str(cand)
    elif spec in BLUEPRINTS:
        text, origin = BLUEPRINTS[spec], "built-in"
    elif spec in PROFILES:
        return {"blueprint": {"name": spec, "summary": f"profile: modules {', '.join(PROFILES[spec])}",
                              "modules": PROFILES[spec]}}, "", "profile"
    else:
        die(f"no blueprint `{spec}` — available: {', '.join([*BLUEPRINTS, *PROFILES])} (or a path to a .toml; see `genome blueprint list`)")
    try:
        data = tomllib.loads(text)
    except tomllib.TOMLDecodeError as e:
        die(f"{origin}: {e}")
    if not isinstance(data.get("blueprint"), dict):
        die(f"{origin}: no [blueprint] table")
    return data, text, origin


def bp_chain(specs: list[str], root: Path | None = None, near: Path | None = None, _seen: tuple = ()) -> list[tuple]:
    """[(name, data, text, origin)] with every `extends` base before the blueprint that names it, each once."""
    out: list[tuple] = []
    for spec in specs:
        data, text, origin = bp_load(spec, root, near)
        b = data["blueprint"]
        name = str(b.get("name") or Path(spec).stem)
        if name in _seen:
            die(f"blueprint `{name}` extends itself ({' → '.join([*_seen, name])})")
        here = Path(origin).parent if origin not in ("built-in", "profile") else near
        for base in bp_chain(list(b.get("extends", [])), root, here, (*_seen, name)):
            if base[0] not in {o[0] for o in out}:
                out.append(base)
        if name not in {o[0] for o in out}:
            out.append((name, data, text, origin))
    return out


def bp_problems(chain: list[tuple]) -> list[str]:
    """What is wrong with the declarations, before anything is applied."""
    out = []
    for name, data, text, origin in chain:
        b = data["blueprint"]
        def bad(msg, n=name):
            out.append(f"blueprint `{n}`: {msg}")
        if set(b) - BP_KEYS:
            bad(f"unknown [blueprint] keys {sorted(set(b) - BP_KEYS)} (known: {', '.join(sorted(BP_KEYS))})")
        if not re.fullmatch(r"[a-z][a-z0-9-]*", name):
            bad("name must be lowercase letters, digits and hyphens")
        if not str(b.get("summary", "")).strip():
            bad("`summary` is required (one line: what the knowledge base is for)")
        if set(b.get("modules", ["core"])) - set(MODULES):
            bad(f"unknown modules {sorted(set(b['modules']) - set(MODULES))}")
        if b.get("privacy") and b["privacy"] not in PRIVACY:
            bad(f"privacy must be one of {PRIVACY}")
        for r in b.get("routes", []):
            if not (isinstance(r, list) and len(r) == 2 and all(isinstance(x, str) and x.strip() for x in r)):
                bad(f"each route is [question, where the answer lives]; got {r!r}")
        if not str(b.get("playbook", "")).strip() and text:
            bad("`playbook` is required: the loop an agent follows, as markdown (it is the blueprint's whole interface)")
    if out:
        return out
    merged: dict = {"kinds": {}, "views": {}}
    for _, _, text, _ in chain:
        more = tomllib.loads(text) if text else {}
        for sec in merged:
            deep_merge(merged[sec], more.get(sec, {}))
    cfg = Cfg(Path("."), {"genome": {"modules": ["core"]}, **merged}, False)
    out += kind_problems(cfg)
    for v, vs in merged["views"].items():
        if vs.get("kind") not in merged["kinds"]:
            out.append(f"E501 view `{v}`: kind `{vs.get('kind')}` is not declared")
        if vs.get("wake") and vs.get("group_count"):
            out.append(f"E501 view `{v}`: wake and group_count do not combine (a queue lists entities)")
        into = str(vs.get("into", ""))
        if into and (into.startswith("/") or ".." in Path(into.partition("#")[0]).parts):
            out.append(f"E501 view `{v}`: `into` must be a path inside the repo")
    for name, data, _, _ in chain:
        for s in data["blueprint"].get("seed", []):
            if s.get("kind") not in merged["kinds"]:
                out.append(f"blueprint `{name}`: seed kind `{s.get('kind')}` is not declared")
    return out


def bp_modules(chain: list[tuple]) -> list[str]:
    return [m for bp in chain for m in bp[1]["blueprint"].get("modules", [])]


def bp_privacy(chain: list[tuple]) -> str:
    ps = [bp[1]["blueprint"]["privacy"] for bp in chain if bp[1]["blueprint"].get("privacy")]
    return min(ps, key=PRIVACY.index) if ps else ""


def bp_preflight(cfg: Cfg, chain: list[tuple]) -> None:
    """Refuse before writing anything: a missing module, or kinds that do not validate against the genome's own."""
    miss = sorted(set(bp_modules(chain)) - cfg.modules)
    if miss:
        die(f"this blueprint needs module(s) {', '.join(miss)}: add them to genome.toml [genome] modules, then re-run")
    import copy
    kinds, views = {}, {}
    for _, _, text, _ in chain:
        more = tomllib.loads(text) if text else {}
        deep_merge(kinds, more.get("kinds", {}))
        deep_merge(views, more.get("views", {}))
    own = tomllib.loads(read(cfg.root / "genome.toml")).get("kinds", {}) if (cfg.root / "genome.toml").is_file() else {}
    clash = sorted(set(kinds) & set(own))
    probs = kind_problems(Cfg(cfg.root, {"genome": {"modules": ["core"]}, "kinds": deep_merge(kinds, copy.deepcopy(cfg.kinds)),
                                         "views": deep_merge(views, copy.deepcopy(cfg.views))}, False))
    if probs:
        die("the blueprint does not fit this genome:\n  " + "\n  ".join(probs))
    for c in clash:
        print(f"genome: note: kind `{c}` is already declared here; the genome's own keys win over the blueprint's", file=sys.stderr)


def agents_add(root: Path, chain: list[tuple]) -> list[str]:
    """Routing rows into AGENTS.md's table (one row per question, once) and a pointer to each playbook."""
    p = root / "AGENTS.md"
    if not p.is_file():
        return ["(no AGENTS.md: routes not added; the playbooks are in docs/playbooks/)"]
    text = read(p)
    if "(one paragraph)" in text and chain[-1][2]:  # a fresh contract says what the project is, from the blueprint
        text = text.replace("(one paragraph)", f"{chain[-1][1]['blueprint']['summary']}.", 1)
        atomic_write(p, text)
    lines = text.splitlines()
    rows = []
    for name, data, text, _ in chain:
        if not text:
            continue
        b = data["blueprint"]
        rows += [(f"how to run the `{name}` loop: its steps and the rules the schema enforces", f"`docs/playbooks/{name}.md`"),
                 *[tuple(r) for r in b.get("routes", [])]]
    new = [f"| {q} | {a} |" for q, a in rows if not any(q in ln for ln in lines)]
    if not new:
        return []
    head = next((i for i, ln in enumerate(lines) if ln.lower().startswith("## routing table")), None)
    if head is not None:
        i = next((k for k in range(head + 1, len(lines)) if lines[k].startswith("|")), None)
        while i is not None and i < len(lines) and lines[i].startswith("|"):
            i += 1
        if i is not None:
            lines[i:i] = new
            atomic_write(p, "\n".join(lines) + "\n")
            return [f"AGENTS.md (+{len(new)} routing row(s))"]
    atomic_write(p, "\n".join(lines) + "\n\n## Routing — blueprints\n\n| question | answer lives in |\n|---|---|\n" + "\n".join(new) + "\n")
    return [f"AGENTS.md (+{len(new)} routing row(s), new table)"]


def privacy_set(root: Path, want: str) -> list[str]:
    """[card] privacy = want in an existing genome.toml, only when it says nothing; never rewrites a stated value."""
    if not want:
        return []
    p = root / "genome.toml"
    text = read(p)
    have = tomllib.loads(text).get("card", {}).get("privacy")
    if have == want:
        return []
    if have:
        print(f"genome: note: [card] privacy is `{have}`; the blueprint asks for `{want}` — change it deliberately if it should hold", file=sys.stderr)
        return []
    if re.search(r"^\[card\]", text, re.M):
        text = re.sub(r"^\[card\][^\n]*\n", lambda m: m.group(0) + f'privacy = "{want}"\n', text, 1, re.M)
    else:
        text = text.rstrip("\n") + f'\n\n[card]\nprivacy = "{want}"\n'
    atomic_write(p, text)
    return [f"genome.toml (+[card] privacy = \"{want}\")"]


def bp_apply(root: Path, chain: list[tuple]) -> list[str]:
    """Copy each blueprint verbatim to genome/kinds/NNN-<name>.toml, route and document it, create its view docs and
    seed, backfill relation defaults, and emit the views. Never overwrites a file."""
    made = []
    kd = root / "genome" / "kinds"
    for name, data, text, _ in chain:
        if not text:
            continue
        have = next(iter(kd.glob(f"*-{name}.toml")), None)
        if have:
            made.append(f"= {cfg_rel(root, have)} (kept{'' if read(have) == text else '; differs from the shipped one'})")
            continue
        kd.mkdir(parents=True, exist_ok=True)
        f = kd / f"{10 * (len(list(kd.glob('*.toml'))) + 1):03}-{name}.toml"
        f.write_text(text)
        made.append(cfg_rel(root, f))
    made += privacy_set(root, bp_privacy(chain))
    cfg = find_cfg(root)
    for k in kind_specs(cfg).values():  # a log kind's file exists from the start, so a route to it never dangles
        f = root / k["path"]
        if k["store"] == "jsonl" and not f.exists():
            atomic_write(f, "")
            made.append(cfg_rel(root, f))
    made += agents_add(root, chain)
    for name, data, text, _ in chain:
        pb = root / "docs" / "playbooks" / f"{name}.md"
        if text and not pb.exists():
            b = data["blueprint"]
            atomic_write(pb, f"# Playbook — {name}\n\n{b['summary']}\n\n_From blueprint `{name}` v{b.get('version', '1')}; "
                             f"edit freely, `genome init` never overwrites it._\n\n{b['playbook'].strip()}\n")
            made.append(cfg_rel(root, pb))
    for v in cfg.views.values():
        target = str(v.get("into", "")).partition("#")[0]
        if target and not (root / target).exists():
            atomic_write(root / target, f"# {Path(target).stem}\n\nGenerated by `genome emit` from saved views; the zones below are not hand-edited.\n")
            made.append(target)
    ents_made = bp_seed(root, cfg, chain)
    made += ents_made
    n = bp_backfill(root, cfg)
    if n:
        made.append(f"{n} existing entit(ies) given their default relations")
    emitted = sorted(set(emit_views(cfg)))
    if emitted:
        made.append("views emitted into " + ", ".join(emitted))
    made.append(f"modules on: {', '.join(cfg.modules)}; kinds: {', '.join(kind_specs(cfg))}")
    return made


def cfg_rel(root: Path, p: Path) -> str:
    return p.relative_to(root).as_posix()


def bp_seed(root: Path, cfg: Cfg, chain: list[tuple]) -> list[str]:
    specs, who, made = kind_specs(cfg), os.environ.get("GENOME_AGENT_ID", "blueprint"), []
    with Guarded(root / ".genome" / "entities"):
        ents, _ = load_entities(cfg)
        for name, data, _, _ in chain:
            for s in data["blueprint"].get("seed", []):
                k = specs[s["kind"]]
                if any(e["kind"] == k["name"] and e["title"] == s.get("title", "") for e in ents.values()):
                    continue
                e = draft_entity(cfg, k, ents, s.get("title", ""), {f: str(v) for f, v in s.get("set", {}).items()},
                                 parse_links(s.get("link", {})), f"blueprint:{name}")
                ents[e["id"]] = e
                persist_new(cfg, k, e, "", who)
                made.append(f"{e['id']} ({k['name']} `{e['title']}`, seed)")
    return made


def bp_backfill(root: Path, cfg: Cfg) -> int:
    """Entities made before a relation with a `default` existed (a blueprint added later) get that default edge."""
    specs, n = kind_specs(cfg), 0
    with Guarded(root / ".genome" / "entities"):
        ents, _ = load_entities(cfg)
        for e in list(ents.values()):
            k = specs[e["kind"]]
            for r, rs in k["relations"].items():
                d = rs.get("default")
                allowed = str(rs.get("to", "*")).split("|")
                if d and not e["rels"].get(r) and d in ents and d != e["id"] and ("*" in allowed or ents[d]["kind"] in allowed):
                    add_edge(cfg, k, e, r, d)
                    n += 1
    return n


# ---- the verbs

def bp_summary_line(name: str, data: dict) -> str:
    b = data["blueprint"]
    ext = f" ← {', '.join(b['extends'])}" if b.get("extends") else ""
    return f"  {name:20} v{b.get('version', '1')}{ext} · {b.get('summary', '')[:110]}" + (f" [{b['privacy']}]" if b.get("privacy") else "")


def fmt_flow(k: dict) -> str:
    """A lifecycle as the legal moves, so an agent need not learn them from a refused one."""
    st, tr, q = k.get("states", []), k.get("transitions", {}), k.get("quarantine")
    if not st:
        return ""
    if not tr:
        return ", ".join(st) + " (any order)"
    ends = [s for s in st if s not in tr and s != q]
    return (f"start {st[0]}: " + " · ".join(f"{a}→{'|'.join(b)}" for a, b in tr.items())
            + (f" · end: {', '.join(ends)}" if ends else "") + (f" · any→{q} (quarantine, with evidence)" if q else ""))


def fmt_field(name: str, spec: str) -> str:
    req = "!" if str(spec).endswith("!") else ""
    typ, _, arg = str(spec).rstrip("!").partition(":")
    return f"{name}{req}" + ("" if typ == "text" else f"={arg}" if typ == "enum" else f":{typ}{arg}")


def fmt_rel(name: str, rs: dict) -> str:
    out = f"{name}→{rs.get('to', '?')}"
    if "min" in rs or "max" in rs:
        out += f" [{rs.get('min', 0)}..{rs.get('max', '')}]"
    if rs.get("required_in"):
        out += " req:" + "|".join(rs["required_in"])
    if rs.get("taint"):
        out += " ⚑" + "|".join(rs["taint"])
    out += (" ↔" if rs.get("symmetric") else "") + (" ~" if rs.get("graph") is False else "") + (f" ={rs['default']}" if rs.get("default") else "")
    return out


def bp_names_local(root: Path | None) -> list[Path]:
    return sorted((root / "genome" / "blueprints").glob("*.toml")) if root else []


def cmd_blueprint(args) -> None:
    root = next((d for d in [Path.cwd().resolve(), *Path.cwd().resolve().parents] if (d / "genome.toml").is_file()), None)
    verb = args.bp_cmd
    if verb == "list":
        print("built-in:")
        for n in BLUEPRINTS:
            print(bp_summary_line(n, bp_load(n)[0]))
        print("profiles (modules only): " + ", ".join(f"{p}={'+'.join(m)}" for p, m in PROFILES.items()))
        local = bp_names_local(root)
        if local:
            print("local (genome/blueprints/):")
            for f in local:
                print(bp_summary_line(f.stem, bp_load(str(f))[0]))
        applied = sorted((root / "genome" / "kinds").glob("*.toml")) if root else []
        if applied:
            print("applied here (genome/kinds/): " + ", ".join(f.name for f in applied))
    elif verb == "show":
        if not args.name:
            die("blueprint show needs a name")
        chain = bp_chain([args.name], root)
        name, data, text, origin = chain[-1]
        b = data["blueprint"]
        if args.toml:
            print(text, end="")
        elif args.playbook:
            print(b.get("playbook", "").strip())
        else:
            kinds, views, own = {}, {}, set(data.get("kinds") or {})
            for _, d, t, _ in chain:  # the whole chain, extensions applied: what the genome will actually have
                deep_merge(kinds, tomllib.loads(t).get("kinds", {}) if t else {})
                deep_merge(views, tomllib.loads(t).get("views", {}) if t else {})
            print(f"{name} v{b.get('version', '1')} [{origin}] modules {'+'.join(b.get('modules', ['core']))}"
                  f"{' · privacy ' + b['privacy'] if b.get('privacy') else ''}"
                  f"{' · extends ' + ', '.join(b['extends']) if b.get('extends') else ''}\n{b['summary']}")
            for kn, k in kinds.items():
                flow = fmt_flow(k)
                hum = f"\n    human-only: {', '.join(k['human_only'])}" if k.get("human_only") else ""
                print(f"- {kn} [{k.get('id', '?')}, {k.get('store', 'dir')}]{' ' + flow if flow else ''}{'' if kn in own else '  (from a base)'}{hum}\n"
                      f"    fields: {', '.join(fmt_field(f, sp) for f, sp in (k.get('fields') or {}).items()) or 'none'}\n"
                      f"    relations: {', '.join(fmt_rel(r, rs) for r, rs in (k.get('relations') or {}).items()) or 'none'}")
            if views:
                print("views: " + ", ".join(f"{v}{'*' if s.get('wake') else ''}" for v, s in views.items()) + "  (* = in wake)")
            print("legend: field! required · [min..max] targets · req:state needs it from that state · ⚑state tainted by that target state · ↔ symmetric · "
                  "~ left out of graph analytics · =ID default\nfull text: `genome blueprint show NAME --toml`; the loop: `--playbook`")
    elif verb == "new":
        if not args.name or not re.fullmatch(r"[a-z][a-z0-9-]*", args.name):
            die("blueprint new needs a name: lowercase letters, digits and hyphens")
        dest = (root or Path.cwd()) / "genome" / "blueprints" / f"{args.name}.toml"
        if dest.exists():
            die(f"{dest} exists; blueprint new never overwrites")
        base = bp_chain([args.base], root) if args.base else []
        taken = {k for b in base for k in (b[1].get("kinds") or {})}
        kn = next(c for c in ("item", "entry", "record", "unit") if c not in taken)
        atomic_write(dest, BP_SKELETON.format(name=args.name, kind=kn, pre=kn[:2].upper(),
                                              extends=json.dumps([args.base] if args.base else []),
                                              mods=json.dumps(sorted(set(bp_modules(base)) | {"core"}))))
        print(f"{dest.relative_to(root) if root else dest} written. Edit it, then `genome blueprint check {dest.relative_to(root) if root else dest}`;\n"
              f"apply with `genome init --blueprint {args.name}`. Authoring rules: references/blueprints.md")
    elif verb == "check":
        names = [args.name] if args.name else list(BLUEPRINTS)
        bad = 0
        for n in names:
            bad += bp_check(n, root, args.keep)
        raise SystemExit(2 if bad else 0)
    else:
        die(f"unknown blueprint command `{verb}`")


BP_SKELETON = '''# {name}: what this knowledge base is for, in one line.
# Check it:  genome blueprint check genome/blueprints/{name}.toml     Apply it:  genome init --blueprint {name}
[blueprint]
name = "{name}"
version = "1"
summary = "one line: what it holds and what an agent can do with it"
extends = {extends}                 # base blueprints applied first; their kinds can be extended below without restating them
modules = {mods}
# privacy = "local"                 # subjective or sensitive data: no card, `close` refuses with a git remote
routes = [
  ["the question an agent will ask", "`where/the/answer/lives`"],
]
playbook = \'\'\'
**What this is.** One paragraph: the purpose, who may decide what, and what is out of scope.

**The loop.**
1. `genome wake` shows the queue.
2. `genome new {kind} --title "…" --set statement="…" --link related=<ID>` records one unit (and its edges) in one call.
3. `genome move <ID> done --evidence <path | entity id | URL>` closes it.
4. `genome graph hubs | cycles | bridges | gaps` finds structure; `genome close` checks everything.
\'\'\'

[kinds.{kind}]
path = "{name}/{kind}s"            # a directory of markdown entities; use store = "jsonl" + a .jsonl path for a volume log
id = "{pre}-{{n:04}}"
fields = {{ statement = "text!" }}   # text · int[:lo..hi] · enum:a|b|c · date · bool; a trailing ! makes it required
states = ["open", "done"]
transitions = {{ open = ["done"] }}
evidence_on = ["done"]              # moving into these needs --evidence
# human_only = ["done"]             # only a person may enter these: `--human <name>`
[kinds.{kind}.relations]
related = {{ to = "{kind}", inverse = "related-to" }}   # min / max / required_in / taint / symmetric / graph = false / default

[views.open-{kind}s]
kind = "{kind}"
state = "open"
wake = true                         # shown in `genome wake` (5 rows)

[views.{kind}-counts]
kind = "{kind}"
group_count = true
into = "docs/{name}.md#{kind}-counts"
'''


# ---- the schema-derived smoke loop

class SmokeFail(Exception):
    pass


def sample_value(spec: str, field: str) -> str:
    typ, _, arg = spec.rstrip("!").partition(":")
    if typ == "enum":
        return re.sub(r"\.\..*", "", arg) if re.fullmatch(r"-?\d+\.\.-?\d+", arg) else arg.split("|")[0]
    if typ == "int":
        return arg.split("..")[0] or "1" if arg else "1"
    return {"date": "2026-01-01", "bool": "true"}.get(typ, f"sample {field}")


def state_path(k: dict, start: str, goal) -> list[str] | None:
    """Shortest run of states from `start` to the first state for which goal(state) holds (quarantine is reachable
    from anywhere); the walk prefers real states over the quarantine exit."""
    q = k.get("quarantine")
    seen, front = {start}, [(start, [])]
    while front:
        s, path = front.pop(0)
        for t in [*k.get("transitions", {}).get(s, []), *([q] if q and s != q else [])]:
            if t in seen:
                continue
            seen.add(t)
            if goal(t):
                return path + [t]
            front.append((t, path + [t]))
    return None


def bp_check(spec: str, root: Path | None, keep: bool = False) -> int:
    """Initialise the blueprint in a scratch dir and drive the real CLI over every kind, relation, state, taint edge
    and view that the declaration implies. Returns 1 on failure. The same loop is a mechanical eval of any blueprint."""
    import tempfile, shutil
    chain = bp_chain([spec], root)
    label = chain[-1][0]
    probs = bp_problems(chain)
    if probs:
        print(f"FAIL {label}: declaration\n  " + "\n  ".join(probs))
        return 1
    tmp = Path(tempfile.mkdtemp(prefix="genome-bp-"))
    calls = 0
    me = [sys.executable, os.path.abspath(__file__)]

    def run(*a, ok=(0,)) -> str:
        nonlocal calls
        calls += 1
        r = subprocess.run([*me, *a], cwd=tmp, capture_output=True, text=True, env={**os.environ, "GENOME_AGENT_ID": "bp-check"})
        if r.returncode not in ok:
            raise SmokeFail(f"genome {' '.join(a)}\n    exit {r.returncode}: {(r.stderr or r.stdout).strip()[:600]}")
        return r.stdout

    stats = {"entities": 0, "edges": 0, "moves": 0, "taint probes": 0}
    try:
        bp_dir = tmp / "_bp"
        bp_dir.mkdir()
        paths = []
        for n, _, text, _ in chain:
            if text:
                (bp_dir / f"{n}.toml").write_text(text)
                paths.append(str(bp_dir / f"{n}.toml"))
        run("init", "--blueprint", ",".join(paths) or label)
        cfg = find_cfg(tmp)
        specs = kind_specs(cfg)
        fresh = run("lint", ok=(0, 2))
        if "lint: clean" not in fresh:
            raise SmokeFail("a freshly initialised genome does not lint clean:\n    " + "\n    ".join(fresh.splitlines()[:6]))
        pool: dict[str, list[str]] = {}
        for e in load_entities(cfg)[0].values():
            pool.setdefault(e["kind"], []).append(e["id"])

        def targets(rs: dict) -> list[str]:
            allowed = [t for t in str(rs.get("to", "*")).split("|") if t]
            return [i for kk, ids in pool.items() if "*" in allowed or kk in allowed for i in ids]

        def need_links(k: dict, state: str | None = None) -> dict[str, list[str]]:
            out = {}
            for r, rs in k["relations"].items():
                n = max(int(rs.get("min", 0)), 1 if (state or k["initial"]) in rs.get("required_in", []) else 0)
                if n and not rs.get("default"):
                    ts = targets(rs)
                    if len(ts) < n:
                        raise SmokeFail(f"`{k['name']}` cannot be created: {r} needs {n} existing {rs.get('to')} entit(ies) and the blueprint has no seed or earlier kind to supply them")
                    out[r] = ts[:n]
            return out

        def make(kn: str, extra: dict | None = None, sets: dict | None = None) -> str:
            k = specs[kn]
            links = {**need_links(k), **(extra or {})}
            a = ["new", kn, "--title", f"smoke {kn}"]
            vals = {f: sample_value(str(sp), f) for f, sp in k["fields"].items() if str(sp).endswith("!")}
            for f, v in {**vals, **(sets or {})}.items():
                a += ["--set", f"{f}={v}"]
            for r, ids in links.items():
                a += ["--link", f"{r}={','.join(ids)}"]
            out = run(*a).split()[0]
            pool.setdefault(kn, []).append(out)
            stats["entities"] += 1
            return out

        # 1. one entity per kind, in the order their required relations allow (two where a relation needs a pair)
        want2 = {t for k in specs.values() for rs in k["relations"].values() if int(rs.get("min", 0)) > 1
                 for t in str(rs.get("to", "")).split("|")}
        todo = list(specs)
        while todo:
            progressed = False
            for kn in list(todo):
                try:
                    for _ in range(2 if kn in want2 else 1):
                        if len(pool.get(kn, [])) < (2 if kn in want2 else 1):
                            make(kn)
                    todo.remove(kn)
                    progressed = True
                except SmokeFail as ex:
                    last = ex
            if not progressed:
                raise last
        # 2. one edge per relation (the first entity of the kind, to the first other entity of an allowed kind)
        for kn, k in specs.items():
            e = pool[kn][0]
            for r, rs in k["relations"].items():
                have = {t for t in load_entities(find_cfg(tmp))[0][e]["rels"].get(r, [])}
                if have or rs.get("default"):
                    continue
                t = next((x for x in targets(rs) if x != e), None)
                if t is None:
                    t = make(next(a for a in str(rs["to"]).split("|") if a in specs and a != "*"))  # a self-targeting relation needs a second entity
                run("link", e, r, t)
                stats["edges"] += 1
        lint = run("lint", ok=(0, 2))
        errs = [ln for ln in lint.splitlines() if re.match(r"E\d", ln)]
        if errs:
            raise SmokeFail("lint after creating one entity and one edge per kind/relation:\n    " + "\n    ".join(errs[:6]))

        def walk(kn: str, goal, extra: dict | None = None, w: str | None = None) -> str:
            """A fresh entity of kind kn (or the existing `w`) moved to a state satisfying goal, evidence and sign-off
            supplied; returns its id."""
            k = specs[kn]
            start = load_entities(find_cfg(tmp))[0][w]["state"] if w else k["initial"]
            path = state_path(k, start, goal)
            if path is None:
                raise SmokeFail(f"`{kn}` has a state that cannot be reached from `{start}` by its transitions")
            w = w or make(kn, extra)
            for s in path:
                for r, rs in k["relations"].items():  # a relation required from this state on is supplied before entering it
                    if s in rs.get("required_in", []) and not load_entities(find_cfg(tmp))[0][w]["rels"].get(r):
                        ts = [x for x in targets(rs) if x != w]
                        if not ts:
                            raise SmokeFail(f"`{kn}` entering `{s}` needs {r} but no {rs.get('to')} entity exists")
                        run("link", w, r, ts[0])
                a = ["move", w, s, "--human", "bp-check"]
                if s in k.get("evidence_ref", {}):  # evidence that must be an entity of a given kind and condition
                    rk, _, cond = str(k["evidence_ref"][s]).partition("?")
                    f_, _, vals = cond.partition("=")
                    a += ["--evidence", make(rk, extra={f_: [w]}) if vals == "@self" else
                          walk(rk, lambda x, ok=vals.split("|"): x in ok) if f_ == "state" else make(rk, sets={f_: vals.split("|")[0]} if f_ else None)]
                elif s in k.get("evidence_on", []) or s == k.get("quarantine"):
                    a += ["--evidence", "genome.toml"]
                run(*a)
                stats["moves"] += 1
            return w

        # 3. every state of every kind is reached (the transition graph is a state machine that can be walked)
        for kn, k in specs.items():
            for s in k["states"]:
                if s != k["initial"]:
                    walk(kn, lambda x, s=s: x == s)
        # 4. every taint edge, as it happens in life: the target goes bad after the pointer exists. Lint flags the
        #    pointer (E510); a new pointer to it is refused on write; quarantining the pointer clears the flag.
        for kn, k in specs.items():
            for r, rs in k["relations"].items():
                if not rs.get("taint"):
                    continue
                tkn = next((t for t in str(rs["to"]).split("|") if t in specs and set(rs["taint"]) & set(specs[t]["states"])), None)
                if tkn is None:
                    continue
                ts, q = next(s for s in rs["taint"] if s in specs[tkn]["states"]), k["quarantine"]
                target = make(tkn)
                src = make(kn, {r: [target]})
                if k["initial"] == q:  # a pointer that starts in quarantine is exempt: take it out first
                    walk(kn, lambda x, q=q: x != q, w=src)
                walk(tkn, lambda x, ts=ts: x == ts, w=target)
                out = run("lint", ok=(0, 2))
                if not any(ln.startswith("E510") and src in ln for ln in out.splitlines()):
                    raise SmokeFail(f"taint: {src} ({kn}.{r}) points at {target} in `{ts}` but lint did not flag it (E510)")
                if src not in run("impact", target, "--to", ts):
                    raise SmokeFail(f"impact: `genome impact {target} --to {ts}` does not list {src}, which lint flags")
                if k["initial"] != q:
                    try:
                        make(kn, {r: [target]})
                        raise SmokeFail(f"taint: a new {kn} was created pointing at {target} in `{ts}`; it should be refused")
                    except SmokeFail as ex:
                        if "should be refused" in str(ex):
                            raise
                run("move", src, q, "--evidence", target)
                if any(ln.startswith("E510") and src in ln for ln in run("lint", ok=(0, 2)).splitlines()):
                    raise SmokeFail(f"taint: {src} was quarantined but lint still flags it")
                stats["taint probes"] += 1
        lint = run("lint", ok=(0, 2))
        errs = [ln for ln in lint.splitlines() if re.match(r"E\d", ln)]
        if errs:
            raise SmokeFail("lint after walking every state:\n    " + "\n    ".join(errs[:6]))
        # 5. views, graph, search, orientation
        run("emit")
        for v in cfg.views:
            run("view", v)
        run("graph", "hubs")
        run("place", "smoke test of the blueprint")
        run("index", "--rebuild")
        wake = run("wake")
        run("close", "--no-gate", ok=(0, 2))
    except SmokeFail as ex:
        print(f"FAIL {label}: {ex}" + f"\n    (scratch genome kept: {tmp})")
        return 1
    if not keep:
        shutil.rmtree(tmp, ignore_errors=True)
    print(f"PASS {label}: {len(specs)} kinds, {sum(len(k['relations']) for k in specs.values())} relations, "
          f"{sum(len(k['states']) for k in specs.values())} states ({stats['moves']} moves), {stats['taint probes']} taint probe(s), "
          f"{len(cfg.views)} views; {calls} CLI calls; wake {len(wake)} bytes (~{len(wake) // 4} tokens)"
          + (f"\n    scratch genome kept: {tmp}" if keep else ""))
    return 0
